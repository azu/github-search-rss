        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/36607?u=79d8c114db476a7ecc6328b328f71d9d758368c7&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>",
            "url": "https://github.com/npm/statusboard/issues/1073",
            "title": "Make pack --json return an object like publish --json instead of an array",
            "date_modified": "2026-04-16T17:27:35.000Z",
            "date_published": "2026-02-24T21:06:26.000Z",
            "author": {
                "name": "wraithgar",
