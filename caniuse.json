            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/14329097?u=33d0fb7c4ff9c80edb8606a21e3e6c8fe3b83734&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">See <a href=\"https://www.rfc-editor.org/rfc/rfc8879.html\" rel=\"nofollow\">https://www.rfc-editor.org/rfc/rfc8879.html</a>.</p>\n<p dir=\"auto\">References: <a href=\"https://www.phoronix.com/news/Mozilla-Firefox-132\" rel=\"nofollow\">https://www.phoronix.com/news/Mozilla-Firefox-132</a></p>",
