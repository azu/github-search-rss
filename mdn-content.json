            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/69888?v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">per <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3251793499\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/content/issues/40499\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/content/issues/40499/hovercard\" href=\"https://github.com/mdn/content/issues/40499\">#40499</a></p>",
