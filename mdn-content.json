        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/17453506?u=8129d257f7585a7d29c00cd70d804d3c2f6af50e&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n<h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">Documentation of the new <code class=\"notranslate\">Element.scrollintoView()</code> <code class=\"notranslate\">container</code> option.</p>\n<h3 dir=\"auto\">Motivation</h3>\n<p dir=\"auto\">The <code class=\"notranslate\">container</code> option has been specified &amp; scheduled to ship in Chrome 140.</p>\n<h3 dir=\"auto\">Additional details</h3>\n<p dir=\"auto\"><a href=\"https://drafts.csswg.org/cssom-view/#dom-scrollintoviewoptions-container\" rel=\"nofollow\">https://drafts.csswg.org/cssom-view/#dom-scrollintoviewoptions-container</a><br>\n<a href=\"https://cr-status.appspot.com/feature/5100036528275456?gate=5140738792488960\" rel=\"nofollow\">https://cr-status.appspot.com/feature/5100036528275456?gate=5140738792488960</a></p>\n<h3 dir=\"auto\">Related issues</h3>\n<p dir=\"auto\"><a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3283478375\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/browser-compat-data/issues/27463\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/browser-compat-data/pull/27463/hovercard\" href=\"https://github.com/mdn/browser-compat-data/pull/27463\">mdn/browser-compat-data#27463</a></p>",
            "url": "https://github.com/mdn/content/pull/40588",
            "title": "Add scrollIntoView() container option",
