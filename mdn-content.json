        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/1300917?u=addded87fd9c1bbe8b348439696de79e37c89d67&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">Untrue/out-of-date since <code class=\"notranslate\">sidebarAction.open()</code>, <code class=\"notranslate\">sidebarAction.close()</code> and <code class=\"notranslate\">sidebarAction.toggle()</code> exist.</p>",
            "url": "https://github.com/mdn/content/pull/40856",
            "title": "Remove sentence saying sidebars cannot be opened programmatically",
            "date_modified": "2025-08-24T11:50:58.000Z",
