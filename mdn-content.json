        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/185639391?u=751c71478b6941fb552bb737eb44052decdd96e2&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">Simplifies two <code class=\"notranslate\">grid</code> syntax examples by removing repeated line names that can be misleading.</p>\n<p dir=\"auto\"><span class=\"issue-keyword tooltipped tooltipped-se\" aria-label=\"This pull request closes issue #41176.\">Fixes</span> <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3426756466\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/content/issues/41176\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/content/issues/41176/hovercard\" href=\"https://github.com/mdn/content/issues/41176\">#41176</a></p>",
            "url": "https://github.com/mdn/content/pull/43701",
            "title": "fix(css): simplify misleading grid syntax examples",
            "date_modified": "2026-04-08T18:39:51.000Z",
            "date_published": "2026-04-08T00:26:22.000Z",
