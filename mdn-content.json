        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/286386?u=bc4894b945491e0834d2306dade7fef748ddf698&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h3 dir=\"auto\">Description</h3>\n<ul dir=\"auto\">\n<li>Removed experimental release note for <code class=\"notranslate\">progress()</code></li>\n<li>Added release note on 155 page for <code class=\"notranslate\">progress()</code></li>\n</ul>\n<h3 dir=\"auto\">Motivation</h3>\n<ul dir=\"auto\">\n<li>Working on <a href=\"https://github.com/mdn/content/issues/45182\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/content/issues/45182/hovercard\">MDN issue #45182</a></li>\n</ul>\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n<ul dir=\"auto\">\n<li><a href=\"https://github.com/mdn/browser-compat-data/pull/30252\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/browser-compat-data/pull/30252/hovercard\">BCD PR</a></li>\n</ul>",
            "url": "https://github.com/mdn/content/pull/45224",
