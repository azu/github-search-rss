        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/69888?v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">Pull out the descriptions from the intro and put them into a description section.<br>\ncreate new data types and link to them<br>\nlink to the new guide (which is in a different PR)</p>",
            "url": "https://github.com/mdn/content/pull/41765",
            "title": "Scroll driven animation properties and types",
