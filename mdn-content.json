        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/55398995?u=9f6a9837c9879eceb0abde487a338b92d4e206fc&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">I've been meaning to do this since 2023. I've finally got around to actually send it. It was huge work for little return (because I write almost all new JS pages anyway), but it may be good for posterity.</p>",
            "url": "https://github.com/mdn/content/pull/45648",
            "title": "JS reference page templates",
            "date_modified": "2026-09-12T03:47:27.000Z",
            "date_published": "2026-09-12T03:42:06.000Z",
