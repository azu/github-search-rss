        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/108879845?u=eeb9306682180ab80521c80fd8f46609fe3c6770&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">Automated changes generated by scripts/update-interface-data via interface-updater github workflow</p>",
            "url": "https://github.com/mdn/content/pull/44056",
            "title": "Update InterfaceData based on WebRef",
            "date_modified": "2026-05-09T00:55:51.000Z",
            "date_published": "2026-05-09T00:55:23.000Z",
            "author": {
                "name": "mdn-bot",
