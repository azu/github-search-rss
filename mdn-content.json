            }
        },
        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/55398995?u=9f6a9837c9879eceb0abde487a338b92d4e206fc&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">We have significantly more labels than documented that triagers should be aware of; this PR adds the missing ones.</p>",
            "url": "https://github.com/mdn/content/pull/41035",
            "title": "Update GH label description in triaging process",
            "date_modified": "2025-09-05T21:24:49.000Z",
