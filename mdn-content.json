        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/43580235?u=cae42d5a371dd041072ce6d85a1808de05535be8&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">The pref <code class=\"notranslate\">layout.css.anchor-positioning.enabled</code> gating CSS anchor positioning features is <code class=\"notranslate\">true</code> by default in Nightly.</p>\n<p dir=\"auto\">Updating Experimental Features for the main entry, updated and moved related entry as child.</p>\n<h3 dir=\"auto\">Additional details</h3>\n<ul dir=\"auto\">\n<li><strong>Bugzilla:</strong>  <a href=\"https://bugzilla.mozilla.org/show_bug.cgi?id=1988224\" rel=\"nofollow\">https://bugzilla.mozilla.org/show_bug.cgi?id=1988224</a></li>\n</ul>\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" id=\"\" disabled=\"\" class=\"task-list-item-checkbox\" aria-label=\"Incomplete task\"> Parent <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3510306554\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/content/issues/41510\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/content/issues/41510/hovercard\" href=\"https://github.com/mdn/content/issues/41510\">#41510</a></li>\n</ul>",
