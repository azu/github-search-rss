        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/69888?v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">part of <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"1533077393\" data-permission-text=\"Title is private\" data-url=\"https://github.com/openwebdocs/project/issues/147\" data-hovercard-type=\"issue\" data-hovercard-url=\"/openwebdocs/project/issues/147/hovercard\" href=\"https://github.com/openwebdocs/project/issues/147\">openwebdocs/project#147</a></p>",
            "url": "https://github.com/mdn/content/pull/40402",
            "title": "CSS text decoration module: refresh and new text-shadow guide",
            "date_modified": "2025-07-18T20:05:32.000Z",
            "date_published": "2025-07-17T09:03:28.000Z",
            "author": {
