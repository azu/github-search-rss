        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/69888?v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>",
            "url": "https://github.com/mdn/content/pull/42016",
            "title": "Add scroll-driven animations to glossary see also",
            "date_modified": "2025-11-19T13:21:30.000Z",
            "date_published": "2025-11-19T13:19:48.000Z",
            "author": {
                "name": "estelle",
