        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/55658154?u=72eb5d6b966bd3197516e3205b1e2f4962df3cc6&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n<h3 dir=\"auto\">Description</h3>\n\n<p dir=\"auto\">Based on <a href=\"https://www.rfc-editor.org/rfc/rfc9110.html#section-9.3.7\" rel=\"nofollow\">RFC9110#section-9.3.7</a></p>\n<div class=\"snippet-clipboard-content notranslate position-relative overflow-auto\" data-snippet-clipboard-copy-content=\"A client that generates an OPTIONS request containing content MUST send a valid [Content-Type](https://www.rfc-editor.org/rfc/rfc9110.html#field.content-type) header field describing the representation media type. Note that this specification does not define any use for such content.\"><pre class=\"notranslate\"><code class=\"notranslate\">A client that generates an OPTIONS request containing content MUST send a valid [Content-Type](https://www.rfc-editor.org/rfc/rfc9110.html#field.content-type) header field describing the representation media type. Note that this specification does not define any use for such content.\n</code></pre></div>\n<p dir=\"auto\">Which means OPTIONS Request \"May\" have body.</p>\n<h3 dir=\"auto\">Motivation</h3>\n\n<h3 dir=\"auto\">Additional details</h3>\n\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n\n\n\n",
            "url": "https://github.com/mdn/content/pull/40146",
            "title": "update http/reference/methods/options/index.md",
            "date_modified": "2025-07-01T12:46:38.000Z",
            "date_published": "2025-07-01T10:34:04.000Z",
            "author": {
