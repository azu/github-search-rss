        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/349114?u=1185d4fc45f5ff4c4a592b30a4dd2bb5cd1b7128&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">Document <a href=\"https://urlpattern.spec.whatwg.org/#dom-urlpattern-hasregexpgroups\" rel=\"nofollow\">https://urlpattern.spec.whatwg.org/#dom-urlpattern-hasregexpgroups</a></p>\n<h3 dir=\"auto\">Motivation</h3>\n<p dir=\"auto\">Add missing docs</p>\n<h3 dir=\"auto\">Additional details</h3>\n<p dir=\"auto\">Chromestatus: <a href=\"https://chromestatus.com/feature/4761338127843328\" rel=\"nofollow\">https://chromestatus.com/feature/4761338127843328</a></p>\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n<p dir=\"auto\"><span class=\"issue-keyword tooltipped tooltipped-se\" aria-label=\"This pull request closes issue #30640.\">Fixes</span> <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"2017387872\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/content/issues/30640\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/content/issues/30640/hovercard\" href=\"https://github.com/mdn/content/issues/30640\">#30640</a></p>",
            "url": "https://github.com/mdn/content/pull/40190",
            "title": "Document URLPattern.hasRegExpGroups",
            "date_modified": "2025-07-03T14:34:08.000Z",
            "date_published": "2025-07-03T14:30:30.000Z",
