        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/495429?u=2f3b9dd03c6c4a961d44a632fe1976c73fa19e1f&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n<h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">Bumps Node.js from v20 to v22.</p>\n<h3 dir=\"auto\">Motivation</h3>\n<p dir=\"auto\">Node.js v22 is the currently active LTS version.</p>\n<h3 dir=\"auto\">Additional details</h3>\n\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n<p dir=\"auto\">Part of <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3188251089\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/mdn/issues/699\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/mdn/issues/699/hovercard\" href=\"https://github.com/mdn/mdn/issues/699\">mdn/mdn#699</a>.</p>",
