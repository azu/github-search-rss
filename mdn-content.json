        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/55398995?u=9f6a9837c9879eceb0abde487a338b92d4e206fc&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\"><span class=\"issue-keyword tooltipped tooltipped-se\" aria-label=\"This pull request closes issue #32704.\">Fix</span> <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"2189521620\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/content/issues/32704\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/content/issues/32704/hovercard\" href=\"https://github.com/mdn/content/issues/32704\">#32704</a></p>",
            "url": "https://github.com/mdn/content/pull/45609",
            "title": "Out-of-gamut origin colors are not special in relative colors",
            "date_modified": "2026-09-10T19:13:12.000Z",
            "date_published": "2026-09-10T19:11:40.000Z",
            "author": {
                "name": "Josh-Cena",
