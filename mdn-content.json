        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/55658154?u=72eb5d6b966bd3197516e3205b1e2f4962df3cc6&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n<h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">According to <a href=\"https://www.rfc-editor.org/rfc/rfc9110.html#name-max-forwards\" rel=\"nofollow\">https://www.rfc-editor.org/rfc/rfc9110.html#name-max-forwards</a></p>\n<div class=\"snippet-clipboard-content notranslate position-relative overflow-auto\" data-snippet-clipboard-copy-content=\"The &quot;Max-Forwards&quot; header field provides a mechanism with the TRACE ([Section 9.3.8](https://www.rfc-editor.org/rfc/rfc9110.html#TRACE)) and OPTIONS ([Section 9.3.7](https://www.rfc-editor.org/rfc/rfc9110.html#OPTIONS)) request methods\"><pre class=\"notranslate\"><code class=\"notranslate\">The \"Max-Forwards\" header field provides a mechanism with the TRACE ([Section 9.3.8](https://www.rfc-editor.org/rfc/rfc9110.html#TRACE)) and OPTIONS ([Section 9.3.7](https://www.rfc-editor.org/rfc/rfc9110.html#OPTIONS)) request methods\n</code></pre></div>\n<h3 dir=\"auto\">Motivation</h3>\n\n<h3 dir=\"auto\">Additional details</h3>\n\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n\n\n\n",
