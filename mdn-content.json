        },
        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/47647?u=2fbfc431a85d357f00c0146d5e55b425b7f00a3d&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n\n<h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">Chrome 150 adds support for the CSS <a href=\"https://drafts.csswg.org/css-text-5/#text-fit-property\" rel=\"nofollow\"><code class=\"notranslate\">text-fit</code></a> property; see <a href=\"https://chromestatus.com/feature/5104141688635392\" rel=\"nofollow\">https://chromestatus.com/feature/5104141688635392</a>.</p>\n<p dir=\"auto\">This PR documents the new property.</p>\n\n<h3 dir=\"auto\">Motivation</h3>\n\n<h3 dir=\"auto\">Additional details</h3>\n\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n\n\n\n",
