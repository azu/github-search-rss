            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/1423607?u=a736aab5a9d4a7543079c64450cd4d1c25417a75&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">Add note on the cancelability of the <code class=\"notranslate\">wheel</code> event.</p>\n<h3 dir=\"auto\">Motivation</h3>\n<p dir=\"auto\">Current description is inaccurate for chromium.</p>\n<h3 dir=\"auto\">Additional details</h3>\n<p dir=\"auto\">See <a href=\"https://issues.chromium.org/issues/40595672#comment5\" rel=\"nofollow\">https://issues.chromium.org/issues/40595672#comment5</a></p>",
