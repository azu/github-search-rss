        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/12285999?u=183d27a6aca0718cb83ecec3c8e7745502384f48&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n<h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">Added a new example to the “Examples” section of the <code class=\"notranslate\">:has</code> pseudo-class page</p>\n\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n<p dir=\"auto\"><span class=\"issue-keyword tooltipped tooltipped-se\" aria-label=\"This pull request closes issue #40697.\">Fixes</span> <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3311214323\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/content/issues/40697\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/content/issues/40697/hovercard\" href=\"https://github.com/mdn/content/issues/40697\">#40697</a></p>\n\n\n\n",
            "url": "https://github.com/mdn/content/pull/40732",
