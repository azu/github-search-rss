        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/43580235?u=cae42d5a371dd041072ce6d85a1808de05535be8&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">The <code class=\"notranslate\">CompositionEvent.locale</code> property is no longer supported.</p>\n<blockquote>\n<p dir=\"auto\">It's <a href=\"https://github.com/w3c/uievents/commit/cb2e9ff0394742744190335b2496ebe976962f06\">removed from the spec in 2013</a> and not implemented by anyone else.</p>\n</blockquote>\n<h3 dir=\"auto\">Bugs</h3>\n<ul dir=\"auto\">\n<li><a href=\"https://bugzilla.mozilla.org/show_bug.cgi?id=1700969\" rel=\"nofollow\">Remove CompositionEvent#locale</a></li>\n</ul>\n<h3 dir=\"auto\">Additional details</h3>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" id=\"\" disabled=\"\" class=\"task-list-item-checkbox\" aria-label=\"Incomplete task\"> Parent issue <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3351705260\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/content/issues/40874\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/content/issues/40874/hovercard\" href=\"https://github.com/mdn/content/issues/40874\">#40874</a></li>\n</ul>",
