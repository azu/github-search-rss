        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/578107?u=840abb68c60c24a23d0e55203f1524a944043c10&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n\n<h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">The demo was using a <code class=\"notranslate\">plum</code>/<code class=\"notranslate\">darkmagenta</code> color/background for links, which has an inaccessible contrast of 4.11:1. This patch swaps <code class=\"notranslate\">darkmagenta</code> for <code class=\"notranslate\">indigo</code>, which gives us a contrast of 6.26:1 (AA)</p>\n<h3 dir=\"auto\">Motivation</h3>\n<p dir=\"auto\">The demo should be accessible</p>\n<h3 dir=\"auto\">Additional details</h3>\n<p dir=\"auto\">∅</p>\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n<p dir=\"auto\">∅</p>",
