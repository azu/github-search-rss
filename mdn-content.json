        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/105274?u=173310b843e2751843265438af8cfb79eda02039&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h3 dir=\"auto\">Description</h3>\n<ul dir=\"auto\">\n<li>Added release note for the <code class=\"notranslate\">EXT_polygon_offset_clamp</code> WebGL extension</li>\n</ul>\n<h3 dir=\"auto\">Motivation</h3>\n<ul dir=\"auto\">\n<li>Working on <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"5617203474\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/content/issues/45888\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/content/issues/45888/hovercard\" href=\"https://github.com/mdn/content/issues/45888\">#45888</a></li>\n</ul>\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n<ul dir=\"auto\">\n<li><a href=\"https://bugzil.la/1854003\" rel=\"nofollow\">Firefox bug 1854003</a></li>\n<li><a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"5809418345\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/browser-compat-data/issues/30843\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/browser-compat-data/pull/30843/hovercard\" href=\"https://github.com/mdn/browser-compat-data/pull/30843\">mdn/browser-compat-data#30843</a></li>\n<li><a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"5809450824\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/content/issues/46106\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/content/pull/46106/hovercard\" href=\"https://github.com/mdn/content/pull/46106\">#46106</a></li>\n</ul>",
