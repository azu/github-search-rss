            }
        },
        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/1141550?u=9e6174a622c42c854578b36fedb1cd14b437ed26&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">Changes for WebDriver conformance for the Firefox 156 release based on the <a href=\"https://bugzilla.mozilla.org/buglist.cgi?include_fields=id,component,resolution,assigned_to,summary,bug_type,whiteboard,mentors&amp;product=Remote%20Protocol&amp;resolution=FIXED&amp;f1=cf_status_firefox156&amp;o1=equals&amp;v1=fixed&amp;f2=cf_status_firefox155&amp;o2=notequals&amp;v2=fixed&amp;f3=status_whiteboard&amp;o3=notsubstring&amp;v3=%5Bwptsync%20downstream%5D&amp;f4=status_whiteboard&amp;o4=substring&amp;v4=%5Bwebdriver%3Arelnote%5D&amp;component=Agent&amp;component=Marionette&amp;component=WebDriver%20BiDi\" rel=\"nofollow\">release note worthy bugs in this list</a>.</p>\n<p dir=\"auto\"><a class=\"user-mention notranslate\" data-hovercard-type=\"user\" data-hovercard-url=\"/users/whimboo/hovercard\" data-octo-click=\"hovercard-link-click\" data-octo-dimensions=\"link_type:self\" href=\"https://github.com/whimboo\">@whimboo</a> and <a class=\"user-mention notranslate\" data-hovercard-type=\"user\" data-hovercard-url=\"/users/lutien/hovercard\" data-octo-click=\"hovercard-link-click\" data-octo-dimensions=\"link_type:self\" href=\"https://github.com/lutien\">@lutien</a> can you please review? Thanks.</p>",
            "url": "https://github.com/mdn/content/pull/45621",
