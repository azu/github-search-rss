        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/47647?u=2fbfc431a85d357f00c0146d5e55b425b7f00a3d&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n\n<h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">The description of packets in <a href=\"https://developer.mozilla.org/en-US/docs/Learn_web_development/Getting_started/Web_standards/How_the_web_works\" rel=\"nofollow\">How the web works</a> is inaccurate. This PR aims to fix it.</p>\n\n<h3 dir=\"auto\">Motivation</h3>\n\n<h3 dir=\"auto\">Additional details</h3>\n\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n<p dir=\"auto\"><span class=\"issue-keyword tooltipped tooltipped-se\" aria-label=\"This pull request closes issue #41479.\">Fixes</span> <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3506721758\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/content/issues/41479\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/content/issues/41479/hovercard\" href=\"https://github.com/mdn/content/issues/41479\">#41479</a>.</p>\n\n\n\n",
