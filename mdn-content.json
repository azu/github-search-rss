        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/286386?u=bc4894b945491e0834d2306dade7fef748ddf698&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h3 dir=\"auto\">Description</h3>\n<ul dir=\"auto\">\n<li>Added release note for <code class=\"notranslate\">alpha</code> &amp; <code class=\"notranslate\">colorspace</code> attributes of <code class=\"notranslate\">&lt;input type=\"color\"&gt;</code>:\n<ul dir=\"auto\">\n<li>Firefox 149 (experimental section)</li>\n<li>Firefox Experimental Features</li>\n</ul>\n</li>\n</ul>\n<h3 dir=\"auto\">Motivation</h3>\n<ul dir=\"auto\">\n<li>Working on <a href=\"https://github.com/mdn/content/issues/43200\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/content/issues/43200/hovercard\">MDN issue #43200</a></li>\n</ul>\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n<ul dir=\"auto\">\n<li><a href=\"https://github.com/mdn/browser-compat-data/pull/29225\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/browser-compat-data/pull/29225/hovercard\">BCD PR</a></li>\n</ul>",
