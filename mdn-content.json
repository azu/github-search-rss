        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/11516302?v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">Fix a link to the module landing page</p>\n\n\n<h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">Fix a link target.</p>\n<h3 dir=\"auto\">Motivation</h3>\n<p dir=\"auto\">This link should be to the module landing page.</p>\n<h3 dir=\"auto\">Additional details</h3>\n\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n\n\n\n",
