        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/55398995?u=9f6a9837c9879eceb0abde487a338b92d4e206fc&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">Part of <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"5170079586\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/content/issues/45183\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/content/issues/45183/hovercard\" href=\"https://github.com/mdn/content/issues/45183\">#45183</a></p>",
            "url": "https://github.com/mdn/content/pull/45199",
            "title": "Reference for stage 3 regexp-buffer-boundaries",
            "date_modified": "2026-08-17T20:38:39.000Z",
            "date_published": "2026-08-17T20:36:55.000Z",
            "author": {
                "name": "Josh-Cena",
