        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/69888?v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">link all occurences of MiTM term to the Manipulator in the middle page.<br>\nupdate \"man in the middle\" to \"manipulator in the middle\"<br>\nadd links to page in MiTM glossary</p>",
            "url": "https://github.com/mdn/content/pull/44683",
            "title": "security links: manipulator-in-the-middle term links to reference",
            "date_modified": "2026-07-11T19:03:07.000Z",
