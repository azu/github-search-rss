        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/10931297?u=600cfcb4c4e709dfbc66b328147d846ee87b1e51&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n\n<h3 dir=\"auto\">Description</h3>\n\n<p dir=\"auto\">Documents <code class=\"notranslate\">performance.interactionCount</code> which has now shipped (or is shipping) in every browser</p>\n<h3 dir=\"auto\">Motivation</h3>\n\n<p dir=\"auto\">Missing docs</p>\n<h3 dir=\"auto\">Additional details</h3>\n\n<p dir=\"auto\">Details here: <a href=\"https://chromestatus.com/feature/5153386492198912\" rel=\"nofollow\">https://chromestatus.com/feature/5153386492198912</a></p>\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n\n\n\n<p dir=\"auto\">Already added to BCD in <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3422725499\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/browser-compat-data/issues/27902\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/browser-compat-data/pull/27902/hovercard\" href=\"https://github.com/mdn/browser-compat-data/pull/27902\">mdn/browser-compat-data#27902</a></p>\n",
            "url": "https://github.com/mdn/content/pull/42646",
            "title": "Add interactionCount docs",
            "date_modified": "2026-01-06T13:51:33.000Z",
            "date_published": "2026-01-06T13:50:05.000Z",
