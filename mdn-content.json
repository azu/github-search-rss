        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/47647?u=2fbfc431a85d357f00c0146d5e55b425b7f00a3d&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n\n<h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">I decided to update the <a href=\"https://developer.mozilla.org/en-US/docs/Learn_web_development/Core/Styling_basics/Tables\" rel=\"nofollow\">Styling tables</a> article to make a few small styling updates and add a live version of the finished design for readers to compare their work against.</p>\n\n<h3 dir=\"auto\">Motivation</h3>\n\n<h3 dir=\"auto\">Additional details</h3>\n\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n\n\n\n",
