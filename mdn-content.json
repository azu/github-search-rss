        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/11926638?v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">It informs that the browser will choose the first image that is bigger than the chosen slot size but it did not mention that the browser would scale it down to the required size.</p>\n\n<h3 dir=\"auto\">Description</h3>\n\n<h3 dir=\"auto\">Motivation</h3>\n\n<h3 dir=\"auto\">Additional details</h3>\n\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n\n\n\n",
