        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/22709264?u=a10979e7969de88f4862300d32505942cd748097&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h2 dir=\"auto\">Summary</h2>\n<ul dir=\"auto\">\n<li>Remove the duplicated <code class=\"notranslate\">property</code> in the Grid auto-placement guide.</li>\n<li>No technical or behavioral changes.</li>\n</ul>",
            "url": "https://github.com/mdn/content/pull/45855",
            "title": "docs(css): remove duplicate \"property\" in grid auto-placement guide",
            "date_modified": "2026-09-26T10:43:16.000Z",
