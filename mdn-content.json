                "name": "natiD1",
                "url": "https://github.com/natiD1"
            }
        },
        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/55398995?u=9f6a9837c9879eceb0abde487a338b92d4e206fc&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\"><span class=\"issue-keyword tooltipped tooltipped-se\" aria-label=\"This pull request closes issue #43892.\">Fixes</span> <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"4307169381\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/content/issues/43892\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/content/issues/43892/hovercard\" href=\"https://github.com/mdn/content/issues/43892\">#43892</a>.</p>\n<p dir=\"auto\">Reduce code verbosity in two code examples, and migrate inline PNG to inline SVG in the other two.</p>\n<p dir=\"auto\">The code has been rebuilt from ground up. The best way to review it is to simply check the behavior.</p>",
