        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/55398995?u=9f6a9837c9879eceb0abde487a338b92d4e206fc&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\"><span class=\"issue-keyword tooltipped tooltipped-se\" aria-label=\"This pull request closes issue #35670.\">Fix</span> <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"2499063704\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/content/issues/35670\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/content/issues/35670/hovercard\" href=\"https://github.com/mdn/content/issues/35670\">#35670</a></p>",
