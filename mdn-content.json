        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/286386?u=bc4894b945491e0834d2306dade7fef748ddf698&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h3 dir=\"auto\">Description</h3>\n<ul dir=\"auto\">\n<li>Updated the description of <code class=\"notranslate\">margin-trim</code></li>\n<li>Added Try It example</li>\n<li>removed the <code class=\"notranslate\">inline-*</code> values</li>\n<li>Updated the example to use <code class=\"notranslate\">block-start</code> value</li>\n</ul>\n<h3 dir=\"auto\">Motivation</h3>\n<ul dir=\"auto\">\n<li>Working on <a href=\"https://github.com/mdn/content/issues/46462\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/content/issues/46462/hovercard\">MDN Issue #46462</a></li>\n<li><a href=\"https://github.com/w3c/csswg-drafts/commit/16a494b33c886b64488c5c724d5bcbcac2b55ead\">PR where inline was removed from spec</a></li>\n<li><a href=\"https://github.com/w3c/csswg-drafts/issues/13731#issuecomment-5190616401\" data-hovercard-type=\"issue\" data-hovercard-url=\"/w3c/csswg-drafts/issues/13731/hovercard\">W3C discussion about removing inline</a></li>\n</ul>\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n<ul dir=\"auto\">\n<li><a href=\"https://github.com/mdn/browser-compat-data/pull/31170\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/browser-compat-data/pull/31170/hovercard\">BCD PR</a></li>\n<li><a href=\"https://github.com/mdn/content/pull/46569\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/content/pull/46569/hovercard\">Firefox Release PR</a></li>\n<li><a href=\"https://github.com/mdn/data/pull/1123\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/data/pull/1123/hovercard\">Data PR</a></li>\n</ul>",
            "url": "https://github.com/mdn/content/pull/46568",
