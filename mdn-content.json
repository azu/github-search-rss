        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/2854910?u=67e0c8d985ca46acdc2f4e8d4b19833301948a89&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">Added descriptions for I420P10 and I420P12 video pixel formats</p>\n<h3 dir=\"auto\">Motivation</h3>\n<p dir=\"auto\">HDR content is often delivered as YUV420P10. VideoFrame supports YUV420P10.<br>\nThis updated doc could be useful for developers who play with HDR</p>\n<h3 dir=\"auto\">Additional details</h3>\n<p dir=\"auto\"><a href=\"https://w3c.github.io/webcodecs/#enumdef-videopixelformat\" rel=\"nofollow\"></a></p>",
