        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/23019147?u=4c0de81596ced64dc067dea5686f7ca2912db0cb&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">This PR updates \"See also\" in CSS guides to ensure:</p>\n<ul dir=\"auto\">\n<li>There's a link to the underlying module page</li>\n<li>The link to the module page is the first or higher among the list of the links where applicable</li>\n</ul>\n<h3 dir=\"auto\">Motivation</h3>\n<p dir=\"auto\">Ensure discoverability and relational linking</p>",
