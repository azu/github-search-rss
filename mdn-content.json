        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/5368500?v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">FF141 adds support for <a href=\"http://localhost:5042/en-US/docs/Web/API/PointerEvent/persistentDeviceId\" rel=\"nofollow\"><code class=\"notranslate\">PointerEvent.persistentDeviceId</code></a> in <a href=\"https://bugzilla.mozilla.org/show_bug.cgi?id=1968400\" rel=\"nofollow\">https://bugzilla.mozilla.org/show_bug.cgi?id=1968400</a></p>\n<p dir=\"auto\">This adds a release not and does minor formatting changes to the property page</p>\n<p dir=\"auto\">Related docs work can be tracked in <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3166056814\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/content/issues/40022\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/content/issues/40022/hovercard\" href=\"https://github.com/mdn/content/issues/40022\">#40022</a></p>",
            "url": "https://github.com/mdn/content/pull/40035",
