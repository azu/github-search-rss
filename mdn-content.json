            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/59975541?u=1869a95d08cfdd426031608f71e1cee02cbde632&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>",
            "url": "https://github.com/mdn/content/pull/45325",
