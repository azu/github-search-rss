    "items": [
        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/47647?u=2fbfc431a85d357f00c0146d5e55b425b7f00a3d&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n<h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">The MDN AudioContext.setSinkId documentation <a href=\"https://developer.mozilla.org/en-US/docs/Web/API/AudioContext/setSinkId\" rel=\"nofollow\">see this, and similar pages</a> has several links to <a href=\"https://set-sink-id.glitch.me/\" rel=\"nofollow\">this demo hosted on Glitch</a>.</p>\n<p dir=\"auto\">Because Glitch is going away, I've filed this PR to update all the remaining links (I removed a few) to point to the same demo on <code class=\"notranslate\">dom-examples</code>.</p>\n\n<h3 dir=\"auto\">Motivation</h3>\n\n<h3 dir=\"auto\">Additional details</h3>\n\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n\n\n\n",
            "url": "https://github.com/mdn/content/pull/40177",
            "title": "Replace AudioContext.setSinkId glitch links",
            "date_modified": "2025-07-02T17:51:29.000Z",
            "date_published": "2025-07-02T17:49:15.000Z",
