        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/47647?u=2fbfc431a85d357f00c0146d5e55b425b7f00a3d&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n\n<h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">The Learn area tutorial entries in the learn sidebar have become inconsistent with those in the cssref sidebar. This PR makes them consistent.</p>\n<p dir=\"auto\">I've not included the test your skills index articles in the cssref sidebar, as I didn't think it was necessary to list them there.</p>\n\n<h3 dir=\"auto\">Motivation</h3>\n\n<h3 dir=\"auto\">Additional details</h3>\n\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n\n\n\n",
