                "name": "chrisdavidmills",
                "url": "https://github.com/chrisdavidmills"
            }
        },
        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/47647?u=2fbfc431a85d357f00c0146d5e55b425b7f00a3d&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n\n\n\n\n<hr>\n<h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">As part of a larger project to make the challenges/reader exercises in MDN learn more consistent, this PR replaces the old code editors in the <a href=\"https://developer.mozilla.org/en-US/docs/Learn_web_development/Core/Structuring_content/Lists\" rel=\"nofollow\">Lists</a> article with a cleaner experience based on MDN Playground.</p>\n<p dir=\"auto\">It also gets rid of the inconsistently used \"Active learning...\" titles.</p>\n\n<h3 dir=\"auto\">Motivation</h3>\n\n<h3 dir=\"auto\">Additional details</h3>\n\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n\n\n",
