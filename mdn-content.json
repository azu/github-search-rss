        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/90179203?u=172e506483f370706d8b15cae57439fff5a1f5f2&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">The return value of <code class=\"notranslate\">Element.getAttributeNode</code> can be null, if the given attribute name does not exist.</p>\n<h3 dir=\"auto\">Motivation</h3>\n<p dir=\"auto\">Provide direct and accurate information.</p>\n<h3 dir=\"auto\">Additional details</h3>\n<p dir=\"auto\">None</p>\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n<p dir=\"auto\">None</p>",
