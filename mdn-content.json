                "url": "https://github.com/dsk-dev-ai"
            }
        },
        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/259028460?u=76c93f0df0fbeb4706736acca78f07a43e398a63&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\"><span class=\"issue-keyword tooltipped tooltipped-se\" aria-label=\"This pull request closes issue #42952.\">Fixes</span> <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3866348085\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/content/issues/42952\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/content/issues/42952/hovercard\" href=\"https://github.com/mdn/content/issues/42952\">#42952</a></p>\n<p dir=\"auto\">Adds clarification that performance.now() returns a floating-point number, which may include fractional milliseconds.</p>",
