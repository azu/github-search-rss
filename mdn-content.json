        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/55398995?u=9f6a9837c9879eceb0abde487a338b92d4e206fc&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\"><span class=\"issue-keyword tooltipped tooltipped-se\" aria-label=\"This pull request closes issue #36542.\">Fix</span> <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"2619008458\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/content/issues/36542\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/content/issues/36542/hovercard\" href=\"https://github.com/mdn/content/issues/36542\">#36542</a></p>",
            "url": "https://github.com/mdn/content/pull/40508",
            "title": "Create a page for blob: URLs",
            "date_modified": "2025-07-23T07:07:07.000Z",
            "date_published": "2025-07-23T06:37:59.000Z",
            "author": {
                "name": "Josh-Cena",
                "url": "https://github.com/Josh-Cena"
