        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/47647?u=2fbfc431a85d357f00c0146d5e55b425b7f00a3d&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n\n<h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">Chrome 151 adds support for the <code class=\"notranslate\">textStream()</code> method on the <code class=\"notranslate\">Request</code>, <code class=\"notranslate\">Response</code>, and <code class=\"notranslate\">Blob</code> interfaces. See <a href=\"https://chromestatus.com/feature/5146752165478400\" rel=\"nofollow\">https://chromestatus.com/feature/5146752165478400</a>.</p>\n<p dir=\"auto\">This PR adds docs for these instances.</p>\n\n<h3 dir=\"auto\">Motivation</h3>\n\n<h3 dir=\"auto\">Additional details</h3>\n\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n\n\n\n",
