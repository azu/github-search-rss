            }
        },
        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/47647?u=2fbfc431a85d357f00c0146d5e55b425b7f00a3d&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n<h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">Chrome 136+ supports the <code class=\"notranslate\">MediaTrackSettings.screenPixelRatio</code> property, on desktop only. See <a href=\"https://chromestatus.com/feature/6738236535472128\" rel=\"nofollow\">https://chromestatus.com/feature/6738236535472128</a> for details.</p>\n<p dir=\"auto\">This PR adds a ref page for the new property.</p>\n\n<h3 dir=\"auto\">Motivation</h3>\n\n<h3 dir=\"auto\">Additional details</h3>\n\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n\n\n\n",
