        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/15207?v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n\n<h3 dir=\"auto\">Description</h3>\n\n<p dir=\"auto\">I have removed an incorrect comma separator in the example</p>\n<h3 dir=\"auto\">Motivation</h3>\n<p dir=\"auto\">I believe that inner lists should use spaces, not commas, for separators.</p>\n<h3 dir=\"auto\">Additional details</h3>\n<p dir=\"auto\">see <a href=\"https://www.rfc-editor.org/rfc/rfc8941.html#section-4.1.1.1\" rel=\"nofollow\">https://www.rfc-editor.org/rfc/rfc8941.html#section-4.1.1.1</a></p>\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n\n\n\n",
