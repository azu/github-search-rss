        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/47647?u=2fbfc431a85d357f00c0146d5e55b425b7f00a3d&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n\n<h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">Chrome 150 adds support for the <a href=\"https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/At-rules/@supports\" rel=\"nofollow\"><code class=\"notranslate\">@supports</code></a> at-rule <a href=\"https://drafts.csswg.org/css-conditional-5/#typedef-supports-named-feature-fn\" rel=\"nofollow\"><code class=\"notranslate\">named-feature()</code></a> function; see <a href=\"https://chromestatus.com/feature/5153932394102784\" rel=\"nofollow\">https://chromestatus.com/feature/5153932394102784</a>.</p>\n<p dir=\"auto\">This PR adds documentation for the new feature, including an example.</p>\n\n<h3 dir=\"auto\">Motivation</h3>\n\n<h3 dir=\"auto\">Additional details</h3>\n\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n\n\n\n",
