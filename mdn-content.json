        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/77869922?u=b5f3f9897ce22d8da4dfd442f60757989f73fb38&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h3 dir=\"auto\">Description</h3>\n<h4 dir=\"auto\">Changes</h4>\n<ul dir=\"auto\">\n<li>Add env example (<code class=\"notranslate\">.env-dist</code>) for project environment variables</li>\n</ul>\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n<p dir=\"auto\">Linked Issues: <a href=\"https://github.com/mdn/fred/issues/761\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/fred/issues/761/hovercard\">#761</a></p>\n<blockquote>\n<p dir=\"auto\">^ The following is an issue created in <a href=\"https://github.com/mdn/fred\">FRED repo</a></p>\n</blockquote>",
            "url": "https://github.com/mdn/content/pull/41266",
            "title": "Add env example",
            "date_modified": "2025-09-29T01:51:51.000Z",
            "date_published": "2025-09-24T04:28:08.000Z",
            "author": {
