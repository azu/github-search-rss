                "url": "https://github.com/kashish2710"
            }
        },
        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/576623?u=88392c52422628facfd7cf108241d2864680915d&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">The article about <code class=\"notranslate\">&lt;hr&gt;</code> element is basic. We can add additional examples.</p>",
