            }
        },
        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/7352080?v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">Adds an example to the <code class=\"notranslate\">commands.onCommand</code> reference to show how to use the <code class=\"notranslate\">tab</code> parameter.</p>\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n<p dir=\"auto\"><span class=\"issue-keyword tooltipped tooltipped-se\" aria-label=\"This pull request closes issue #33008.\">Fixes</span> <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"2232595395\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/content/issues/33008\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/content/issues/33008/hovercard\" href=\"https://github.com/mdn/content/issues/33008\">#33008</a></p>",
            "url": "https://github.com/mdn/content/pull/44018",
