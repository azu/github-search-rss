        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/286386?u=bc4894b945491e0834d2306dade7fef748ddf698&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h3 dir=\"auto\">Description</h3>\n<ul dir=\"auto\">\n<li>Updated the content in <code class=\"notranslate\">color-mix()</code> to refer to 1 or more colors rather than 2</li>\n</ul>\n<h3 dir=\"auto\">Motivation</h3>\n<ul dir=\"auto\">\n<li>Working on <a href=\"https://github.com/mdn/content/issues/43560\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/content/issues/43560/hovercard\">MDN issue #43560</a></li>\n</ul>\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n<ul dir=\"auto\">\n<li><a href=\"https://github.com/mdn/browser-compat-data/pull/29430\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/browser-compat-data/pull/29430/hovercard\">BCD PR</a></li>\n<li><a href=\"https://github.com/mdn/content/pull/43710\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/content/pull/43710/hovercard\">FF release PR</a></li>\n</ul>",
