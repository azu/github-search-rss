        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/110662505?u=7b946884785a92cdc8666bbc4b67edab1b1266fb&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">This PR updates the default format<br>\n<span class=\"issue-keyword tooltipped tooltipped-se\" aria-label=\"This pull request closes issue #40410.\">closes</span> <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3239567939\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/content/issues/40410\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/content/issues/40410/hovercard\" href=\"https://github.com/mdn/content/issues/40410\">#40410</a></p>",
