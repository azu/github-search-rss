        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/69888?v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">took a look at documented features that have no support</p>",
            "url": "https://github.com/mdn/content/pull/40576",
            "title": "CSS modules: separate out unsupported features",
            "date_modified": "2025-07-31T09:26:32.000Z",
            "date_published": "2025-07-31T00:07:21.000Z",
            "author": {
                "name": "estelle",
