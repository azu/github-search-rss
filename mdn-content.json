        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/201158231?v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n\n<h3 dir=\"auto\">Description</h3>\n\n<p dir=\"auto\">Chrome 150 adds support for the <code class=\"notranslate\">MediaStreamTrackProcessor</code> <code class=\"notranslate\">discardedFrames</code> &amp; <code class=\"notranslate\">totalFrames</code> properties: see <a href=\"https://chromestatus.com/feature/6267249280286720\" rel=\"nofollow\">https://chromestatus.com/feature/6267249280286720</a>.</p>\n<p dir=\"auto\">This PR adds docs for the new properties</p>\n<h3 dir=\"auto\">Motivation</h3>\n\n<h3 dir=\"auto\">Additional details</h3>\n\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n\n\n\n",
