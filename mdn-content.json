        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/286386?u=bc4894b945491e0834d2306dade7fef748ddf698&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h3 dir=\"auto\">Description</h3>\n<ul dir=\"auto\">\n<li>Added Firefox release note for <code class=\"notranslate\">vertical-align</code> to be a shorthand property</li>\n</ul>\n<h3 dir=\"auto\">Motivation</h3>\n<ul dir=\"auto\">\n<li>Workiong on <a href=\"https://github.com/mdn/content/issues/43198\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/content/issues/43198/hovercard\">MDN issue #43198</a></li>\n</ul>\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n<ul dir=\"auto\">\n<li><a href=\"https://github.com/mdn/content/pull/43484\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/content/pull/43484/hovercard\">Content PR</a></li>\n<li><a href=\"https://github.com/mdn/browser-compat-data/pull/29290\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/browser-compat-data/pull/29290/hovercard\">BCD PR</a></li>\n<li><a href=\"https://github.com/mdn/data/pull/1054\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/data/pull/1054/hovercard\">Data PR</a></li>\n</ul>",
