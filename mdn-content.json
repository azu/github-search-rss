            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/20392302?u=5dcac116a63e4eaf0fd7243fdf8e9139962831ae&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n\n<h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">jQuery .attr() does not sanitize values.</p>\n\n<h3 dir=\"auto\">Motivation</h3>\n\n<h3 dir=\"auto\">Additional details</h3>\n\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n\n\n\n",
