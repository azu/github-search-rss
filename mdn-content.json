        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/286386?u=bc4894b945491e0834d2306dade7fef748ddf698&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h3 dir=\"auto\">Description</h3>\n<ul dir=\"auto\">\n<li>Added experimental release note for <code class=\"notranslate\">alpha()</code></li>\n<li>Added experimental note on 154 page for <code class=\"notranslate\">alpha()</code></li>\n</ul>\n<h3 dir=\"auto\">Motivation</h3>\n<ul dir=\"auto\">\n<li>Working on <a href=\"https://github.com/mdn/content/issues/44844\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/content/issues/44844/hovercard\">MDN issue #44844</a></li>\n</ul>\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n<ul dir=\"auto\">\n<li><a href=\"https://github.com/mdn/browser-compat-data/pull/30260\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/browser-compat-data/pull/30260/hovercard\">BCD PR</a></li>\n</ul>",
            "url": "https://github.com/mdn/content/pull/45219",
            "title": "added release notes for alpha() css function",
