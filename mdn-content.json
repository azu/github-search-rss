        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/286386?u=bc4894b945491e0834d2306dade7fef748ddf698&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h3 dir=\"auto\">Description</h3>\n<ul dir=\"auto\">\n<li>Created <code class=\"notranslate\">:active-view-transition</code> pseudo-class page</li>\n<li>Added inline example to <code class=\"notranslate\">document.startViewTransition</code> method page</li>\n</ul>\n<h3 dir=\"auto\">Motivation</h3>\n<ul dir=\"auto\">\n<li>Working on <a href=\"https://github.com/mdn/content/issues/40029\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/content/issues/40029/hovercard\">issue #40029</a></li>\n</ul>\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n<h4 dir=\"auto\">Related issues</h4>\n<ul dir=\"auto\">\n<li><a href=\"https://github.com/mdn/browser-compat-data/pull/27315\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/browser-compat-data/pull/27315/hovercard\">BCD PR</a></li>\n<li><a href=\"https://github.com/mdn/content/pull/40403\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/content/pull/40403/hovercard\">Firefox Release PR</a></li>\n</ul>",
