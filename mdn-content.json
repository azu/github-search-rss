        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/5368500?v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">FF157 adds support for the <code class=\"notranslate\">export * from \"mod\"</code> syntax behind a pref and in nightly only in <a href=\"https://bugzil.la/2065611\" rel=\"nofollow\">https://bugzil.la/2065611</a></p>\n<p dir=\"auto\">This adds the release note</p>\n<p dir=\"auto\">Related docs work can be tracked in <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"5448400967\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/content/issues/45699\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/content/issues/45699/hovercard\" href=\"https://github.com/mdn/content/issues/45699\">#45699</a></p>",
            "url": "https://github.com/mdn/content/pull/45843",
