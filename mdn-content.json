                "name": "chrisdavidmills",
                "url": "https://github.com/chrisdavidmills"
            }
        },
        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/69888?v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">Updated the description and syntax for the <code class=\"notranslate\">view-timeline-axis</code> property, clarifying its use in named view progress timelines and providing additional context on its functionality.</p>",
