        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/108879845?u=eeb9306682180ab80521c80fd8f46609fe3c6770&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">This PR was generated by <a href=\"https://github.com/mdn/content/actions/runs/20082568615\">this run</a> of the <a href=\"https://github.com/mdn/content/blob/main/.github/workflows/auto-cleanup-bot.yml\"><code class=\"notranslate\">auto-cleanup-bot</code></a> workflow.</p>\n<p dir=\"auto\">All issues were auto-fixed.</p>",
            "url": "https://github.com/mdn/content/pull/42335",
            "title": "fix: auto-cleanup by bot",
            "date_modified": "2025-12-10T00:12:28.000Z",
            "date_published": "2025-12-10T00:10:49.000Z",
            "author": {
                "name": "mdn-bot",
