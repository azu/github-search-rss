        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/349114?u=1185d4fc45f5ff4c4a592b30a4dd2bb5cd1b7128&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">Documentation for <code class=\"notranslate\">VideoFrame.flip</code> and <code class=\"notranslate\">VideoFrame.rotation</code>.</p>\n<h3 dir=\"auto\">Motivation</h3>\n<p dir=\"auto\">This shipped in Chromium-based browsers.</p>\n<h3 dir=\"auto\">Additional details</h3>\n<p dir=\"auto\">I haven't documented anything on MDN in quite a while. Please take this apart but be gentle with me.</p>\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n<p dir=\"auto\"><a href=\"https://chromestatus.com/feature/5128855343595520\" rel=\"nofollow\">https://chromestatus.com/feature/5128855343595520</a></p>",
