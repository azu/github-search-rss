        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/9350426?u=9d2ac3234eb4094f2e152baa591af30951c9dc2a&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n<h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">Updating a variable name from \"someTargetElement\" to \"someElement\" in a given code example</p>\n<h3 dir=\"auto\">Motivation</h3>\n<p dir=\"auto\">The previous name did not seem to match the one that is used in the very same example</p>\n<h3 dir=\"auto\">Additional details</h3>\n\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n\n\n\n",
