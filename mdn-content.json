        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/1823771?u=553be8d72a31be6190ab10cdc0cef49a5c7c2bc4&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n\n<h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">Use a better data structure and simplify code.</p>\n<h3 dir=\"auto\">Motivation</h3>\n<p dir=\"auto\">The code is unclear.</p>\n<h3 dir=\"auto\">Additional details</h3>\n\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n\n\n\n",
            "url": "https://github.com/mdn/content/pull/41399",
