        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/47647?u=2fbfc431a85d357f00c0146d5e55b425b7f00a3d&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n\n<h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">Firefox 145 adds support for the <code class=\"notranslate\">position-area</code> property: see <a href=\"https://bugzilla.mozilla.org/show_bug.cgi?id=1924086\" rel=\"nofollow\">https://bugzilla.mozilla.org/show_bug.cgi?id=1924086</a>. From testing, it appears to be only enabled in nightly builds.</p>\n<p dir=\"auto\">This PR adds an entry for <code class=\"notranslate\">position-area</code> to the Firefox Experimental features page.</p>\n\n<h3 dir=\"auto\">Motivation</h3>\n\n<h3 dir=\"auto\">Additional details</h3>\n\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n\n\n\n",
