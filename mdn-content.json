        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/90582190?u=42818c7d5d2ee6aa051a66f1477789350f6a5863&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">A minor update to reflect a change we made in our cookie behavior prefs, and a clarifying sentence.</p>\n<h3 dir=\"auto\">Motivation</h3>\n<p dir=\"auto\">Our team made a change to ETP recently and want to make sure MDN reflects reality</p>\n<h3 dir=\"auto\">Additional details</h3>\n<p dir=\"auto\"><a href=\"https://bugzilla.mozilla.org/show_bug.cgi?id=1918342\" rel=\"nofollow\">https://bugzilla.mozilla.org/show_bug.cgi?id=1918342</a></p>\n<h3 dir=\"auto\">Related issues and pull requests</h3>",
