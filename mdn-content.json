        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/286386?u=bc4894b945491e0834d2306dade7fef748ddf698&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h3 dir=\"auto\">Description</h3>\n<ul dir=\"auto\">\n<li>Added note to FF 150 about nesting of <code class=\"notranslate\">@container style()</code> queries</li>\n<li>Added the bug to Experimental Features</li>\n</ul>\n<h3 dir=\"auto\">Motivation</h3>\n<ul dir=\"auto\">\n<li>Working on <a href=\"https://github.com/mdn/content/issues/43547\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/content/issues/43547/hovercard\">MDN issue #43547</a></li>\n</ul>\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n<ul dir=\"auto\">\n<li><a href=\"https://github.com/mdn/content/pull/43840\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/content/pull/43840/hovercard\">Content PR</a></li>\n</ul>",
            "url": "https://github.com/mdn/content/pull/43839",
            "title": "added release notes for nested @container style() queries",
            "date_modified": "2026-04-17T14:33:19.000Z",
            "date_published": "2026-04-17T11:03:30.000Z",
