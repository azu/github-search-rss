                "name": "chrisdavidmills",
                "url": "https://github.com/chrisdavidmills"
            }
        },
        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/43580235?u=cae42d5a371dd041072ce6d85a1808de05535be8&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">CSS <code class=\"notranslate\">font-family: math</code> is enabled in Fx by default in 145.</p>\n<h4 dir=\"auto\">Test results and supporting details</h4>\n<ul dir=\"auto\">\n<li><a href=\"https://bugzilla.mozilla.org/show_bug.cgi?id=1788937\" rel=\"nofollow\">https://bugzilla.mozilla.org/show_bug.cgi?id=1788937</a></li>\n</ul>\n<h4 dir=\"auto\">Related issues</h4>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" id=\"\" disabled=\"\" class=\"task-list-item-checkbox\" aria-label=\"Incomplete task\"> Parent <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3510270262\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/content/issues/41506\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/content/issues/41506/hovercard\" href=\"https://github.com/mdn/content/issues/41506\">#41506</a></li>\n</ul>",
