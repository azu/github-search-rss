            }
        },
        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/47647?u=2fbfc431a85d357f00c0146d5e55b425b7f00a3d&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n\n<h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">Chrome 144 adds support for the <a href=\"https://drafts.csswg.org/css-pseudo-4/#selectordef-search-text\" rel=\"nofollow\"><code class=\"notranslate\">::search-text</code></a> pseudo-element; see <a href=\"https://chromestatus.com/feature/5195073796177920\" rel=\"nofollow\">https://chromestatus.com/feature/5195073796177920</a>.</p>\n<p dir=\"auto\">This PR provides documentation for the new feature.</p>\n\n<h3 dir=\"auto\">Motivation</h3>\n\n<h3 dir=\"auto\">Additional details</h3>\n\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n\n\n\n",
