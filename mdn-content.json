            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/94725606?u=bf63289642ef8e707a668b8184c8f94106916ce9&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n\n<h3 dir=\"auto\">Description</h3>\n\n<p dir=\"auto\">Update font-display example to use correct format.</p>\n<h3 dir=\"auto\">Motivation</h3>\n\n<p dir=\"auto\">format(\"eot\") ×<br>\nformat(\"embedded-opentype\") √</p>\n<h3 dir=\"auto\">Additional details</h3>\n\n<p dir=\"auto\"><a href=\"https://developer.mozilla.org/en-US/docs/Web/CSS/@font-face/src#font_formats\" rel=\"nofollow\">https://developer.mozilla.org/en-US/docs/Web/CSS/@font-face/src#font_formats</a></p>\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n\n\n\n",
