        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/1323194?u=93e4d24fee9e70f1199839b665e9285308b78818&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">See <a href=\"https://bugzilla.mozilla.org/show_bug.cgi?id=1991270#c3\" rel=\"nofollow\">https://bugzilla.mozilla.org/show_bug.cgi?id=1991270#c3</a> for details.</p>",
            "url": "https://github.com/mdn/content/pull/41406",
            "title": "Document that ::-moz-meter-bar now needs appearance: none to work properly.",
            "date_modified": "2025-10-06T14:08:40.000Z",
