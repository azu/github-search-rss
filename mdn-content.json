        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/69888?v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>",
            "url": "https://github.com/mdn/content/pull/41961",
            "title": "Glossary page: css macros instead of links",
            "date_modified": "2025-11-17T11:05:35.000Z",
            "date_published": "2025-11-16T19:16:16.000Z",
            "author": {
