        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/141821420?u=de60eafd0a685374a46e1cbe2edd5423d084649c&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\"><span class=\"issue-keyword tooltipped tooltipped-se\" aria-label=\"This pull request closes issue #45605.\">Fixes</span> <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"5412793735\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/content/issues/45605\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/content/issues/45605/hovercard\" href=\"https://github.com/mdn/content/issues/45605\">#45605</a></p>",
            "url": "https://github.com/mdn/content/pull/45625",
            "title": "Fix placeholder example variable name (input → input element)",
