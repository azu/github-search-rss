        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/2854910?u=67e0c8d985ca46acdc2f4e8d4b19833301948a89&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">Updated list of transfer characteristics</p>\n<h3 dir=\"auto\">Motivation</h3>\n<p dir=\"auto\">This is important for devs who want to build HDR frame</p>\n<h3 dir=\"auto\">Additional details</h3>\n<p dir=\"auto\"><a href=\"https://w3c.github.io/webcodecs/#videotransfercharacteristics\" rel=\"nofollow\">https://w3c.github.io/webcodecs/#videotransfercharacteristics</a></p>\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n<p dir=\"auto\"><a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3431890824\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/content/issues/41203\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/content/pull/41203/hovercard\" href=\"https://github.com/mdn/content/pull/41203\">#41203</a></p>",
            "url": "https://github.com/mdn/content/pull/41204",
            "title": "Update transfer characteristics in index.md",
            "date_modified": "2025-09-18T20:44:08.000Z",
            "date_published": "2025-09-18T20:41:52.000Z",
