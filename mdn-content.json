        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/41184947?u=dc63bc6f8b1d2895c923fdd8689b2d487d329945&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">I do strongly consider this is a typo, as it's irrelevant with content above, and, with the whole repository.</p>\n<p dir=\"auto\"><code class=\"notranslate\">DTS transport</code> =&gt; <code class=\"notranslate\">DTLS transport</code></p>",
            "url": "https://github.com/mdn/content/pull/42704",
            "title": "fix typo in RTCTransportStats",
            "date_modified": "2026-01-09T10:10:32.000Z",
            "date_published": "2026-01-09T10:08:39.000Z",
