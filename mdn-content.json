        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/23019147?u=4c0de81596ced64dc067dea5686f7ca2912db0cb&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">This PR updates glossary titles to follow sentence casing convention, especially where the term is not a proper noun.</p>\n<h3 dir=\"auto\">Motivation</h3>\n<p dir=\"auto\">To follow the MDN style guide (<a href=\"https://developer.mozilla.org/en-US/docs/MDN/Writing_guidelines/Writing_style_guide#titles\" rel=\"nofollow\">Titles</a>)</p>",
            "url": "https://github.com/mdn/content/pull/40195",
            "title": "fix(glossary): Update titles to follow MDN sentence casing convention",
            "date_modified": "2025-07-04T00:26:04.000Z",
            "date_published": "2025-07-03T16:26:25.000Z",
            "author": {
                "name": "dipikabh",
