        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/495429?u=2f3b9dd03c6c4a961d44a632fe1976c73fa19e1f&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n<h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">Moves all dependencies to <code class=\"notranslate\">devDependencies</code>.</p>\n<h3 dir=\"auto\">Motivation</h3>\n<p dir=\"auto\">Avoid confusion, and allow updating all dependencies together in a group (pending Dependabot config update).</p>\n<h3 dir=\"auto\">Additional details</h3>\n\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n<p dir=\"auto\">Same as:</p>\n<ul dir=\"auto\">\n<li><a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3917680664\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/translated-content/issues/33227\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/translated-content/pull/33227/hovercard\" href=\"https://github.com/mdn/translated-content/pull/33227\">mdn/translated-content#33227</a></li>\n</ul>",
