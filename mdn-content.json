        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/47647?u=2fbfc431a85d357f00c0146d5e55b425b7f00a3d&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n\n<h3 dir=\"auto\">Description</h3>\n<p dir=\"auto\">Firefox 158 adds support for <a href=\"https://developer.mozilla.org/en-US/docs/Web/CSS/Guides/Values_and_units/Using_typed_arithmetic\" rel=\"nofollow\">typed arithmetic</a>; see <a href=\"https://bugzilla.mozilla.org/show_bug.cgi?id=2067411\" rel=\"nofollow\">https://bugzilla.mozilla.org/show_bug.cgi?id=2067411</a>.</p>\n<p dir=\"auto\">This PR adds a release note to document the new feature release.</p>\n\n<h3 dir=\"auto\">Motivation</h3>\n\n<h3 dir=\"auto\">Additional details</h3>\n\n<h3 dir=\"auto\">Related issues and pull requests</h3>\n\n\n\n",
