        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/55398995?u=9f6a9837c9879eceb0abde487a338b92d4e206fc&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">See <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3427531482\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/content/issues/41181\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/content/pull/41181/hovercard\" href=\"https://github.com/mdn/content/pull/41181\">#41181</a></p>",
            "url": "https://github.com/mdn/content/pull/41182",
            "title": "Remove unnecessary useCapture parameter from addEventListener (2)",
            "date_modified": "2025-09-17T19:28:14.000Z",
            "date_published": "2025-09-17T19:26:05.000Z",
            "author": {
                "name": "Josh-Cena",
