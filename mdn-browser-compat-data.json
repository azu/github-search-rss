        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/286386?u=bc4894b945491e0834d2306dade7fef748ddf698&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h4 dir=\"auto\">Summary</h4>\n<ul dir=\"auto\">\n<li>Updated the <code class=\"notranslate\">spec_url</code> for <code class=\"notranslate\">vertical-align</code></li>\n</ul>\n<h4 dir=\"auto\">Related issues</h4>\n<ul dir=\"auto\">\n<li><a href=\"https://github.com/mdn/content/pull/43484\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/content/pull/43484/hovercard\">Content PR</a></li>\n<li><a href=\"https://github.com/mdn/data/pull/1054\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/data/pull/1054/hovercard\">Data PR</a></li>\n<li><a href=\"https://github.com/mdn/content/pull/43485\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/content/pull/43485/hovercard\">Firefox release PR</a></li>\n</ul>",
