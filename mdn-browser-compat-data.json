        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/286386?u=bc4894b945491e0834d2306dade7fef748ddf698&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h4 dir=\"auto\">Summary</h4>\n<ul dir=\"auto\">\n<li>Added accepts <code class=\"notranslate\">&lt;image&gt;</code> for <code class=\"notranslate\">light-dark()</code> color function</li>\n</ul>\n<h4 dir=\"auto\">Test results and supporting details</h4>\n<p dir=\"auto\">Tested using these codepens:</p>\n<ul dir=\"auto\">\n<li><a href=\"https://codepen.io/CodeRedDigital/pen/YPGaGNE\" rel=\"nofollow\">https://codepen.io/CodeRedDigital/pen/YPGaGNE</a></li>\n<li><a href=\"https://codepen.io/CodeRedDigital/pen/raMdZBX\" rel=\"nofollow\">https://codepen.io/CodeRedDigital/pen/raMdZBX</a></li>\n<li><a href=\"https://codepen.io/CodeRedDigital/pen/jEMzXOQ\" rel=\"nofollow\">https://codepen.io/CodeRedDigital/pen/jEMzXOQ</a></li>\n<li><a href=\"https://codepen.io/CodeRedDigital/pen/GgjxXWQ\" rel=\"nofollow\">https://codepen.io/CodeRedDigital/pen/GgjxXWQ</a></li>\n<li><a href=\"https://codepen.io/CodeRedDigital/pen/raMdPGz\" rel=\"nofollow\">https://codepen.io/CodeRedDigital/pen/raMdPGz</a></li>\n</ul>\n<h5 dir=\"auto\">Passes</h5>\n<ul dir=\"auto\">\n<li>Firefox Beta 150</li>\n<li>Firefox Developer Edition 150</li>\n<li>Firefox Nightly 151</li>\n</ul>\n<h6 dir=\"auto\">With flag set</h6>\n<ul dir=\"auto\">\n<li>Chrome Canary 148</li>\n<li>Chrome Developer 148</li>\n<li>Edge Canary 148</li>\n<li>Edge Dev 148</li>\n</ul>\n<h5 dir=\"auto\">Fails</h5>\n<ul dir=\"auto\">\n<li>Firefox 149</li>\n<li>Chrome Beta 147</li>\n<li>Edge Beta 147</li>\n<li>Opera Developer 147</li>\n<li>Safari Technology Preview 240</li>\n<li>Safari 26.4</li>\n</ul>\n<h4 dir=\"auto\">Related issues</h4>\n<ul dir=\"auto\">\n<li><a href=\"https://github.com/mdn/content/pull/43707\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/content/pull/43707/hovercard\">Content PR</a></li>\n<li><a href=\"https://github.com/mdn/content/pull/43708\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/content/pull/43708/hovercard\">FF release PR</a></li>\n</ul>",
