        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/1795135?u=8b4759f2d0964426ac6f2aeacf061ad1ee0e24db&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n<p dir=\"auto\">See <a href=\"https://webkit.org/b/286920\" rel=\"nofollow\">https://webkit.org/b/286920</a> for implementation details.</p>\n<p dir=\"auto\">Scroll-driven animations shipped in Safari 26 beta: <a href=\"https://webkit.org/blog/16993/news-from-wwdc25-web-technology-coming-this-fall-in-safari-26-beta/\" rel=\"nofollow\">https://webkit.org/blog/16993/news-from-wwdc25-web-technology-coming-this-fall-in-safari-26-beta/</a></p>\n",
