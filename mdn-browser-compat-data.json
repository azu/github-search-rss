                "name": "rebloor",
                "url": "https://github.com/rebloor"
            }
        },
        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/108879845?u=eeb9306682180ab80521c80fd8f46609fe3c6770&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">(This PR was generated by the <a href=\"https://github.com/mdn/browser-compat-data/blob/main/.github/workflows/update-webdriver-bidi-data.yml\"><code class=\"notranslate\">update-webdriver-bidi-data</code></a> workflow.)</p>",
