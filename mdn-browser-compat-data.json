        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/104558794?u=a09e971c48172ab0d149bfba0550ed9221e0f076&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h4 dir=\"auto\">Summary</h4>\n<p dir=\"auto\">Added  version_removed: \"18.5\" in browser-compat-data/http/headers/Set-Cookie.json for Safari based on issue <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3132464012\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/browser-compat-data/issues/27023\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/browser-compat-data/issues/27023/hovercard\" href=\"https://github.com/mdn/browser-compat-data/issues/27023\">#27023</a></p>",
