            }
        },
        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/1795135?u=8b4759f2d0964426ac6f2aeacf061ad1ee0e24db&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">This has been supported since Safari 9, see <a href=\"https://caniuse.com/css-filter-function\" rel=\"nofollow\">https://caniuse.com/css-filter-function</a>.</p>\n<p dir=\"auto\"><a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3450347886\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/mdn/issues/726\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/mdn/issues/726/hovercard\" href=\"https://github.com/mdn/mdn/issues/726\">mdn/mdn#726</a></p>",
