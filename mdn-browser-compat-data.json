        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/97435840?u=a82a5f520219a28246154bea38e587feb3aae9b4&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n<h4 dir=\"auto\">Summary</h4>\n<p dir=\"auto\">Added version_removed to the theme-color metadata tag for Safari 26</p>\n<h4 dir=\"auto\">Test results and supporting details</h4>\n<p dir=\"auto\">See <a href=\"https://caniuse.com/?search=theme-color\" rel=\"nofollow\">https://caniuse.com/?search=theme-color</a></p>",
            "url": "https://github.com/mdn/browser-compat-data/pull/28229",
            "title": "Add version_removed for theme-color for Safari",
            "date_modified": "2025-10-18T06:55:40.000Z",
