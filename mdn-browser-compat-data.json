        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/5179191?u=8dd92441fba3cb438759ee98862670ba56f2c67d&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">This PR updates and corrects version values for Microsoft Edge for the <code class=\"notranslate\">getDigitalGoodsService</code> member of the <code class=\"notranslate\">Window</code> API. The data comes from the <a href=\"https://mdn-bcd-collector.gooborg.com\" rel=\"nofollow\">mdn-bcd-collector</a> project (v10.13.2).</p>\n<p dir=\"auto\"><em>Check out the <a href=\"https://github.com/openwebdocs/mdn-bcd-collector#reviewing-bcd-changes\">collector's guide on how to review this PR</a>.</em></p>\n<p dir=\"auto\">Tests Used: <a href=\"https://mdn-bcd-collector.gooborg.com/tests/api/Window/getDigitalGoodsService\" rel=\"nofollow\">https://mdn-bcd-collector.gooborg.com/tests/api/Window/getDigitalGoodsService</a></p>",
            "url": "https://github.com/mdn/browser-compat-data/pull/26952",
