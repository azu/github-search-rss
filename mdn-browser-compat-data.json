        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/17036061?u=becea1794942100f6fe2be3a310afc188b7bde2e&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n<h4 dir=\"auto\">Summary</h4>\n\n<p dir=\"auto\">Safari 26 beta supports find-in-page with <code class=\"notranslate\">content-visibility: auto</code>.</p>\n<h4 dir=\"auto\">Test results and supporting details</h4>\n\n\n<p dir=\"auto\">See Safari 26.0 Beta Release Notes:<br>\n<a href=\"https://developer.apple.com/documentation/safari-release-notes/safari-26-release-notes#:~:text=Fixed%20content%20skipped%20with%20content%2Dvisibility:%20auto%20to%20be%20findable.%20(141237620)%20(FB16079870)\" rel=\"nofollow\">https://developer.apple.com/documentation/safari-release-notes/safari-26-release-notes#:~:text=Fixed%20content%20skipped%20with%20content%2Dvisibility:%20auto%20to%20be%20findable.%20(141237620)%20(FB16079870)</a></p>",
            "url": "https://github.com/mdn/browser-compat-data/pull/27032",
