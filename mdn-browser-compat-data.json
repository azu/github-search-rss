        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/32498324?u=33625fe335fbb6a8a62271bcc211afc447904e8a&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n<h4 dir=\"auto\">Summary</h4>\n<p dir=\"auto\">Add spec_url to base-select value of appearance property</p>\n\n<h4 dir=\"auto\">Test results and supporting details</h4>\n<p dir=\"auto\">Since <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"2920799401\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/browser-compat-data/issues/26221\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/browser-compat-data/pull/26221/hovercard\" href=\"https://github.com/mdn/browser-compat-data/pull/26221\">#26221</a> - this feature has been correctly added to the css-ui spec.</p>\n\n\n<h4 dir=\"auto\">Related issues</h4>\n\n",
            "url": "https://github.com/mdn/browser-compat-data/pull/28129",
            "title": "Add spec_url to base-select value of appearance property",
            "date_modified": "2025-10-08T13:33:08.000Z",
            "date_published": "2025-10-08T13:31:54.000Z",
