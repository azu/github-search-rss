    "items": [
        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/47647?u=2fbfc431a85d357f00c0146d5e55b425b7f00a3d&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n<h4 dir=\"auto\">Summary</h4>\n<p dir=\"auto\">This PR doesn't add any new data, but it cleans up <code class=\"notranslate\">paymentrequest.securePaymentConfirmationAvailability()</code>, which is currently displaying untidily. This adds a description and a spec URL.</p>\n\n<h4 dir=\"auto\">Test results and supporting details</h4>\n\n\n<h4 dir=\"auto\">Related issues</h4>\n\n",
            "url": "https://github.com/mdn/browser-compat-data/pull/27642",
            "title": "add description for securePaymentConfirmationAvailability",
            "date_modified": "2025-08-21T21:58:47.000Z",
            "date_published": "2025-08-21T20:24:06.000Z",
            "author": {
                "name": "chrisdavidmills",
                "url": "https://github.com/chrisdavidmills"
            }
        },
        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/47647?u=2fbfc431a85d357f00c0146d5e55b425b7f00a3d&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">…property</p>\n\n<h4 dir=\"auto\">Summary</h4>\n<p dir=\"auto\">Chrome 139 updates the <a href=\"https://developer.mozilla.org/en-US/docs/Web/API/RTCEncodedAudioFrame/getMetadata\" rel=\"nofollow\"><code class=\"notranslate\">RTCEncodedAudioFrame.getMetadata()</code></a> method so that the <a href=\"https://w3c.github.io/webrtc-encoded-transform/#dom-rtcencodedaudioframemetadata-audiolevel\" rel=\"nofollow\"><code class=\"notranslate\">audioLevel</code></a> property is available in its return object. See <a href=\"https://chromestatus.com/feature/5206106602995712\" rel=\"nofollow\">https://chromestatus.com/feature/5206106602995712</a>.</p>\n<p dir=\"auto\">This PR adds a data point for the new return object property. The description might need a bit of work, as I wasn't sure of the standard for this kind of addition.</p>\n\n<h4 dir=\"auto\">Test results and supporting details</h4>\n\n\n<h4 dir=\"auto\">Related issues</h4>\n\n",
            "url": "https://github.com/mdn/browser-compat-data/pull/27641",
            "title": "Chrome 139 adds RTCEncodedAudioFrame.getMetadata() audioLevel return …",
            "date_modified": "2025-08-21T18:56:13.000Z",
            "date_published": "2025-08-21T18:55:33.000Z",
            "author": {
                "name": "chrisdavidmills",
                "url": "https://github.com/chrisdavidmills"
            }
        },
        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/47647?u=2fbfc431a85d357f00c0146d5e55b425b7f00a3d&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n<h4 dir=\"auto\">Summary</h4>\n<p dir=\"auto\">Chrome 139 adds support for the WebGPU <a href=\"https://gpuweb.github.io/gpuweb/#core-features-and-limits\" rel=\"nofollow\"><code class=\"notranslate\">core-features-and-limits</code></a> feature. See <a href=\"https://chromestatus.com/feature/4744775089258496\" rel=\"nofollow\">https://chromestatus.com/feature/4744775089258496</a>.</p>\n<p dir=\"auto\">This PR adds a data point for the new feature.</p>\n\n<h4 dir=\"auto\">Test results and supporting details</h4>\n\n\n<h4 dir=\"auto\">Related issues</h4>\n\n",
            "url": "https://github.com/mdn/browser-compat-data/pull/27640",
            "title": "Chrome 139 support for WebGPU core-features-and-limits feature",
            "date_modified": "2025-08-21T16:51:51.000Z",
            "date_published": "2025-08-21T16:51:12.000Z",
            "author": {
                "name": "chrisdavidmills",
                "url": "https://github.com/chrisdavidmills"
            }
        },
        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/64103?u=428d3c27c9cd7efc648e17dfe5a4321c3f8e44d2&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h4 dir=\"auto\">Summary</h4>\n<p dir=\"auto\">This was dropped from the specification. Developers shouldn't use it and it has unshipped from all browsers anyway.</p>\n<h4 dir=\"auto\">Related issues</h4>\n<ul dir=\"auto\">\n<li><a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"2720947362\" data-permission-text=\"Title is private\" data-url=\"https://github.com/w3c/csswg-drafts/issues/11326\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/w3c/csswg-drafts/pull/11326/hovercard\" href=\"https://github.com/w3c/csswg-drafts/pull/11326\">w3c/csswg-drafts#11326</a></li>\n<li><a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3339032375\" data-permission-text=\"Title is private\" data-url=\"https://github.com/web-platform-dx/web-features/issues/3238\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/web-platform-dx/web-features/pull/3238/hovercard\" href=\"https://github.com/web-platform-dx/web-features/pull/3238\">web-platform-dx/web-features#3238</a></li>\n</ul>",
            "url": "https://github.com/mdn/browser-compat-data/pull/27638",
            "title": "De-standardize `:closed` pseudo-class",
            "date_modified": "2025-08-21T16:31:12.000Z",
            "date_published": "2025-08-21T12:08:53.000Z",
            "author": {
                "name": "ddbeck",
                "url": "https://github.com/ddbeck"
            }
        },
        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/47647?u=2fbfc431a85d357f00c0146d5e55b425b7f00a3d&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n<h4 dir=\"auto\">Summary</h4>\n<p dir=\"auto\">Chrome 139 adds support for the <a href=\"https://html.spec.whatwg.org/multipage/form-elements.html#attr-button-command-request-close\" rel=\"nofollow\"><code class=\"notranslate\">request-close</code></a> value of the <code class=\"notranslate\">&lt;button&gt;</code> element's <code class=\"notranslate\">command</code> attribute. See <a href=\"https://chromestatus.com/feature/5592399713402880\" rel=\"nofollow\">https://chromestatus.com/feature/5592399713402880</a>.</p>\n<p dir=\"auto\">BCD also includes a data point for the same value on the <code class=\"notranslate\">HTMLButtonElement.command</code> DOM property.</p>\n<p dir=\"auto\">This PR adds this data to the <code class=\"notranslate\">&lt;button&gt;</code> element too, so it is available there.</p>\n\n<h4 dir=\"auto\">Test results and supporting details</h4>\n\n\n<h4 dir=\"auto\">Related issues</h4>\n\n",
