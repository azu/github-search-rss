        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/644927?u=790461985bc61a38ef27bed89be1fdec9ace7cbc&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n<h4 dir=\"auto\">Summary</h4>\n<p dir=\"auto\">Firefox 144 now displays a time picker for <code class=\"notranslate\">datetime-local</code>.</p>\n<h4 dir=\"auto\">Test results and supporting details</h4>\n<p dir=\"auto\">The Bugzilla ticket was resolve as fixed a couple of hours ago as like \"implemented in Firefox 144\".</p>\n<h4 dir=\"auto\">Related issues</h4>\n<p dir=\"auto\"><a href=\"https://bugzilla.mozilla.org/show_bug.cgi?id=1726108\" rel=\"nofollow\">https://bugzilla.mozilla.org/show_bug.cgi?id=1726108</a></p>",
