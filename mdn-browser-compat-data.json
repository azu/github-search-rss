        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/108879845?u=eeb9306682180ab80521c80fd8f46609fe3c6770&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">The output of the <code class=\"notranslate\">tag-web-features</code> script is:</p>\n<blockquote>\n<p dir=\"auto\">@mdn/browser-compat-data@7.3.7 tag-web-features<br>\nnode scripts/tag-web-features.js ..</p>\n</blockquote>\n<div class=\"highlight highlight-source-diff notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"# api.Request.formData\n# api.Response.formData\n- web-features:fetch\n+ web-features:fetch-formdata\n\n# api.ReportingObserver.ReportingObserver.options_parameter\n# api.ReportingObserver.ReportingObserver.options_parameter.types_property\n# api.ReportingObserver.ReportingObserver.options_parameter.types_property.coep\n# api.ReportingObserver.ReportingObserver.options_parameter.types_property.csp-violation\n# api.ReportingObserver.ReportingObserver.options_parameter.types_property.deprecation\n# api.ReportingObserver.ReportingObserver.options_parameter.types_property.integrity-violation\n# api.ReportingObserver.ReportingObserver.options_parameter.types_property.intervention\n+ web-features:reporting\"><pre class=\"notranslate\"><span class=\"pl-c\"><span class=\"pl-c\">#</span> api.Request.formData</span>\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> api.Response.formData</span>\n<span class=\"pl-md\"><span class=\"pl-md\">-</span> web-features:fetch</span>\n<span class=\"pl-mi1\"><span class=\"pl-mi1\">+</span> web-features:fetch-formdata</span>\n\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> api.ReportingObserver.ReportingObserver.options_parameter</span>\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> api.ReportingObserver.ReportingObserver.options_parameter.types_property</span>\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> api.ReportingObserver.ReportingObserver.options_parameter.types_property.coep</span>\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> api.ReportingObserver.ReportingObserver.options_parameter.types_property.csp-violation</span>\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> api.ReportingObserver.ReportingObserver.options_parameter.types_property.deprecation</span>\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> api.ReportingObserver.ReportingObserver.options_parameter.types_property.integrity-violation</span>\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> api.ReportingObserver.ReportingObserver.options_parameter.types_property.intervention</span>\n<span class=\"pl-mi1\"><span class=\"pl-mi1\">+</span> web-features:reporting</span></pre></div>",
