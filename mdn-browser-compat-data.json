        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/17036061?u=becea1794942100f6fe2be3a310afc188b7bde2e&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">Support for <code class=\"notranslate\">Math.sumPrecise</code> was added in Safari 26.2:</p>\n<p dir=\"auto\"><a href=\"https://developer.apple.com/documentation/safari-release-notes/safari-26_2-release-notes#JavaScript\" rel=\"nofollow\">https://developer.apple.com/documentation/safari-release-notes/safari-26_2-release-notes#JavaScript</a></p>",
