        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/10931297?u=600cfcb4c4e709dfbc66b328147d846ee87b1e51&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n<h4 dir=\"auto\">Summary</h4>\n\n<p dir=\"auto\">Safari supports <code class=\"notranslate\">navigational-prefetch</code> <code class=\"notranslate\">deliveryType</code> in Resource Timing behind a flag.</p>\n<h4 dir=\"auto\">Test results and supporting details</h4>\n\n<ul dir=\"auto\">\n<li>Turn on the flag</li>\n<li>Visit <a href=\"https://chrome.dev/prerender-demos/prefetch.html\" rel=\"nofollow\">https://chrome.dev/prerender-demos/prefetch.html</a></li>\n<li>Click on the first link</li>\n</ul>\n<p dir=\"auto\">Results:</p>\n<a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://private-user-images.githubusercontent.com/10931297/587775742-9a0be035-a0ff-415c-b3fa-9827eeee6600.png?jwt=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..oXWRguFkSBdFQbobleiET8bhrIeqkihB8Rvaarwo90g\"><img width=\"1310\" height=\"833\" alt=\"image\" src=\"https://private-user-images.githubusercontent.com/10931297/587775742-9a0be035-a0ff-415c-b3fa-9827eeee6600.png?jwt=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..oXWRguFkSBdFQbobleiET8bhrIeqkihB8Rvaarwo90g\" style=\"max-width: 100%; height: auto; max-height: 833px;; aspect-ratio: 1310 / 833; background-color: var(--bgColor-muted); border-radius: 6px; display: block\" class=\"js-gh-image-fallback\"></a>\n\n<h4 dir=\"auto\">Related issues</h4>\n\n",
