        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/47647?u=2fbfc431a85d357f00c0146d5e55b425b7f00a3d&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n<h4 dir=\"auto\">Summary</h4>\n<p dir=\"auto\">Chrome 145 adds support for the <code class=\"notranslate\">subgroup_uniformity</code> WGSL language extension. See <a href=\"https://chromestatus.com/feature/5673998232977408\" rel=\"nofollow\">https://chromestatus.com/feature/5673998232977408</a>.</p>\n<p dir=\"auto\">This PR adds a data point for it.</p>\n\n<h4 dir=\"auto\">Test results and supporting details</h4>\n\n\n<h4 dir=\"auto\">Related issues</h4>\n\n",
            "url": "https://github.com/mdn/browser-compat-data/pull/29422",
            "title": "Chrome 145 subgroup_uniformity",
            "date_modified": "2026-04-07T14:49:13.000Z",
