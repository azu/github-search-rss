        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/5857447?u=bc96931c238d983d81ff7c231f2917e66a4cedcf&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h4 dir=\"auto\">Summary</h4>\n<p dir=\"auto\">Firefox now supports compact-shift  since 144 version see : <a href=\"https://www.firefox.com/en-US/firefox/144.0/releasenotes/\" rel=\"nofollow\">https://www.firefox.com/en-US/firefox/144.0/releasenotes/</a></p>\n<h4 dir=\"auto\">Test results and supporting details</h4>\n<p dir=\"auto\">have not tested the changes, change from boolean to string, should be fine</p>",
            "url": "https://github.com/mdn/browser-compat-data/pull/28253",
            "title": "Update Firefox version_added for math-shift property",
            "date_modified": "2025-10-20T16:49:42.000Z",
