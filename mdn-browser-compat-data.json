        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/87750369?u=ccc1f52005708ae16bcb50e325e02145bff0ef7d&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h4 dir=\"auto\">Summary</h4>\n<p dir=\"auto\">Add the compat data for <code class=\"notranslate\">css.types.color.contrast-color</code> function.</p>\n<h4 dir=\"auto\">Test results and supporting details</h4>\n<ul dir=\"auto\">\n<li><a href=\"https://webkit.org/blog/16929/contrast-color/\" rel=\"nofollow\">https://webkit.org/blog/16929/contrast-color/</a></li>\n<li><a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"2846321986\" data-permission-text=\"Title is private\" data-url=\"https://github.com/WebKit/WebKit/issues/40424\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/WebKit/WebKit/pull/40424/hovercard\" href=\"https://github.com/WebKit/WebKit/pull/40424\">WebKit/WebKit#40424</a></li>\n<li></li>\n</ul>\n<h4 dir=\"auto\">Related issues</h4>\n<p dir=\"auto\"><span class=\"issue-keyword tooltipped tooltipped-se\" aria-label=\"This pull request closes issue #26987.\">Fixes</span> <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3119612777\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/browser-compat-data/issues/26987\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/browser-compat-data/issues/26987/hovercard\" href=\"https://github.com/mdn/browser-compat-data/issues/26987\">#26987</a></p>",
