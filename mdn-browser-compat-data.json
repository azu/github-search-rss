        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/495429?u=2f3b9dd03c6c4a961d44a632fe1976c73fa19e1f&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n<h4 dir=\"auto\">Summary</h4>\n<p dir=\"auto\">Chrome Android 138 supports Web Serial</p>\n<h4 dir=\"auto\">Test results and supporting details</h4>\n<p dir=\"auto\"><a href=\"https://chromestatus.com/feature/5139978918821888\" rel=\"nofollow\">https://chromestatus.com/feature/5139978918821888</a></p>\n<h4 dir=\"auto\">Related issues</h4>\n<p dir=\"auto\"><span class=\"issue-keyword tooltipped tooltipped-se\" aria-label=\"This pull request closes issue #23802.\">Fixes</span> <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"2405751441\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/browser-compat-data/issues/23802\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/browser-compat-data/issues/23802/hovercard\" href=\"https://github.com/mdn/browser-compat-data/issues/23802\">#23802</a>.</p>",
            "url": "https://github.com/mdn/browser-compat-data/pull/28818",
            "title": "Chrome Android 138 supports Web Serial",
            "date_modified": "2026-01-23T17:28:44.000Z",
