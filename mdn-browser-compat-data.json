        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/70075?u=df101eb48a2ed7fb44aa4f8de4a976baf1846a6c&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h4 dir=\"auto\">Summary</h4>\n<p dir=\"auto\">Set the compatibility data for NodeJS to <code class=\"notranslate\">24.0.0</code> in the <code class=\"notranslate\">using</code> statement section.</p>\n<h4 dir=\"auto\">Test results and supporting details</h4>\n<ol dir=\"auto\">\n<li><a href=\"https://github.com/nodejs/node/blob/main/doc/changelogs/CHANGELOG_V24.md#v8-136\">https://github.com/nodejs/node/blob/main/doc/changelogs/CHANGELOG_V24.md#v8-136</a></li>\n<li><a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3037901177\" data-permission-text=\"Title is private\" data-url=\"https://github.com/nodejs/node/issues/58154\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/nodejs/node/pull/58154/hovercard\" href=\"https://github.com/nodejs/node/pull/58154\">nodejs/node#58154</a></li>\n<li><a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3057333488\" data-permission-text=\"Title is private\" data-url=\"https://github.com/nodejs/node/issues/58296\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/nodejs/node/pull/58296/hovercard\" href=\"https://github.com/nodejs/node/pull/58296\">nodejs/node#58296</a></li>\n</ol>\n<h4 dir=\"auto\">Related issues</h4>\n<p dir=\"auto\"><span class=\"issue-keyword tooltipped tooltipped-se\" aria-label=\"This pull request closes issue #27631.\">Closes</span> <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3338871190\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/browser-compat-data/issues/27631\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/browser-compat-data/issues/27631/hovercard\" href=\"https://github.com/mdn/browser-compat-data/issues/27631\">#27631</a></p>",
