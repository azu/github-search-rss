            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/286386?u=bc4894b945491e0834d2306dade7fef748ddf698&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h4 dir=\"auto\">Summary</h4>\n<ul dir=\"auto\">\n<li>Added the mdn_url for:\n<ul dir=\"auto\">\n<li><code class=\"notranslate\">:heading</code></li>\n<li><code class=\"notranslate\">:heading()</code></li>\n</ul>\n</li>\n</ul>\n<h4 dir=\"auto\">Related issues</h4>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" id=\"\" disabled=\"\" class=\"task-list-item-checkbox\" aria-label=\"Completed task\" checked=\"\"> Content PR <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3296289790\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/content/issues/40649\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/content/pull/40649/hovercard\" href=\"https://github.com/mdn/content/pull/40649\">mdn/content#40649</a>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" id=\"\" disabled=\"\" class=\"task-list-item-checkbox\" aria-label=\"Completed task\" checked=\"\"> New Content PR <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3330985848\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/content/issues/40784\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/content/pull/40784/hovercard\" href=\"https://github.com/mdn/content/pull/40784\">mdn/content#40784</a></li>\n</ul>\n</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" id=\"\" disabled=\"\" class=\"task-list-item-checkbox\" aria-label=\"Completed task\" checked=\"\"> BCD PR <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3293352909\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/browser-compat-data/issues/27504\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/browser-compat-data/pull/27504/hovercard\" href=\"https://github.com/mdn/browser-compat-data/pull/27504\">#27504</a></li>\n<li class=\"task-list-item\"><input type=\"checkbox\" id=\"\" disabled=\"\" class=\"task-list-item-checkbox\" aria-label=\"Completed task\" checked=\"\"> Firefox Release Note PR <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3296949070\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/content/issues/40655\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/content/pull/40655/hovercard\" href=\"https://github.com/mdn/content/pull/40655\">mdn/content#40655</a></li>\n</ul>",
