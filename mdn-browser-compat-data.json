            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/108879845?u=eeb9306682180ab80521c80fd8f46609fe3c6770&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">The output of the <code class=\"notranslate\">tag-web-features</code> script is:</p>\n<blockquote>\n<p dir=\"auto\">@mdn/browser-compat-data@8.1.5 tag-web-features<br>\nnode scripts/tag-web-features.js ..</p>\n</blockquote>\n<div class=\"highlight highlight-source-diff notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"# api.CSSPseudoElement\n# api.CSSPseudoElement.element\n# api.CSSPseudoElement.type\n- web-features:css-object-model\n+ web-features:css-object-model-csspseudoelement\n\n# css.properties.align-items.end\n# css.properties.align-items.start\n- web-features:grid\n+ web-features:flexbox\n\n# javascript.builtins.String.substr\n- web-features:html-wrapper-methods\n+ web-features:string-substr\n\n# javascript.builtins.Iterator.zip\n# javascript.builtins.Iterator.zipKeyed\n- web-features:iterator-methods\n+ web-features:iterator-zip-zipkeyed\n\n# api.AnimationEvent.animation\n# api.TransitionEvent.animation\n+ web-features:animations-css-animation-accessors\n\n# css.properties.border-image-source.none\n+ web-features:border-image\n\n# api.CSSPseudoElement.parent\n# api.CSSPseudoElement.pseudo\n# api.Element.pseudo\n+ web-features:css-object-model-csspseudoelement\n\n# http.headers.Upgrade\n+ web-features:http11\n\n# html.elements.input.autocomplete\n+ web-features:input\n\n# javascript.builtins.Iterator.includes\n+ web-features:iterator-includes\n\n# css.properties.columns.auto\n+ web-features:multi-column\n\n# api.Window.postMessage.transfer_parameter\n+ web-features:postmessage\n\n# html.elements.script.type.module.http_errors_not_cached\n# javascript.operators.import.http_errors_not_cached\n# javascript.statements.import.http_errors_not_cached\n+ web-features:retriable-module-loading\n\n# css.properties.scroll-axis-lock\n# css.properties.scroll-axis-lock.auto\n# css.properties.scroll-axis-lock.none\n+ web-features:scroll-axis-lock\n\n# api.Selection.collapse.offset_parameter_optional\n# api.Selection.extend.offset_parameter_optional\n+ web-features:selection-api\n\n# css.properties.color-interpolation.linearRGB\n+ web-features:svg\n\n# css.types.color.system-color.accentcolor\n# css.types.color.system-color.accentcolortext\n+ web-features:system-color\n\n# css.properties.text-decoration-skip-spaces\n# css.properties.text-decoration-skip-spaces.all\n# css.properties.text-decoration-skip-spaces.end\n# css.properties.text-decoration-skip-spaces.none\n# css.properties.text-decoration-skip-spaces.start\n+ web-features:text-decoration-skip-spaces\n\n# api.WheelEvent.momentum\n+ web-features:wheel-events-momentum\n\n# http.headers.X-Frame-Options\n# http.headers.X-Frame-Options.DENY\n# http.headers.X-Frame-Options.SAMEORIGIN\n+ web-features:x-frame-options\"><pre class=\"notranslate\"><span class=\"pl-c\"><span class=\"pl-c\">#</span> api.CSSPseudoElement</span>\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> api.CSSPseudoElement.element</span>\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> api.CSSPseudoElement.type</span>\n<span class=\"pl-md\"><span class=\"pl-md\">-</span> web-features:css-object-model</span>\n<span class=\"pl-mi1\"><span class=\"pl-mi1\">+</span> web-features:css-object-model-csspseudoelement</span>\n\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> css.properties.align-items.end</span>\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> css.properties.align-items.start</span>\n<span class=\"pl-md\"><span class=\"pl-md\">-</span> web-features:grid</span>\n<span class=\"pl-mi1\"><span class=\"pl-mi1\">+</span> web-features:flexbox</span>\n\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> javascript.builtins.String.substr</span>\n<span class=\"pl-md\"><span class=\"pl-md\">-</span> web-features:html-wrapper-methods</span>\n<span class=\"pl-mi1\"><span class=\"pl-mi1\">+</span> web-features:string-substr</span>\n\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> javascript.builtins.Iterator.zip</span>\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> javascript.builtins.Iterator.zipKeyed</span>\n<span class=\"pl-md\"><span class=\"pl-md\">-</span> web-features:iterator-methods</span>\n<span class=\"pl-mi1\"><span class=\"pl-mi1\">+</span> web-features:iterator-zip-zipkeyed</span>\n\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> api.AnimationEvent.animation</span>\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> api.TransitionEvent.animation</span>\n<span class=\"pl-mi1\"><span class=\"pl-mi1\">+</span> web-features:animations-css-animation-accessors</span>\n\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> css.properties.border-image-source.none</span>\n<span class=\"pl-mi1\"><span class=\"pl-mi1\">+</span> web-features:border-image</span>\n\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> api.CSSPseudoElement.parent</span>\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> api.CSSPseudoElement.pseudo</span>\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> api.Element.pseudo</span>\n<span class=\"pl-mi1\"><span class=\"pl-mi1\">+</span> web-features:css-object-model-csspseudoelement</span>\n\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> http.headers.Upgrade</span>\n<span class=\"pl-mi1\"><span class=\"pl-mi1\">+</span> web-features:http11</span>\n\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> html.elements.input.autocomplete</span>\n<span class=\"pl-mi1\"><span class=\"pl-mi1\">+</span> web-features:input</span>\n\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> javascript.builtins.Iterator.includes</span>\n<span class=\"pl-mi1\"><span class=\"pl-mi1\">+</span> web-features:iterator-includes</span>\n\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> css.properties.columns.auto</span>\n<span class=\"pl-mi1\"><span class=\"pl-mi1\">+</span> web-features:multi-column</span>\n\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> api.Window.postMessage.transfer_parameter</span>\n<span class=\"pl-mi1\"><span class=\"pl-mi1\">+</span> web-features:postmessage</span>\n\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> html.elements.script.type.module.http_errors_not_cached</span>\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> javascript.operators.import.http_errors_not_cached</span>\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> javascript.statements.import.http_errors_not_cached</span>\n<span class=\"pl-mi1\"><span class=\"pl-mi1\">+</span> web-features:retriable-module-loading</span>\n\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> css.properties.scroll-axis-lock</span>\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> css.properties.scroll-axis-lock.auto</span>\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> css.properties.scroll-axis-lock.none</span>\n<span class=\"pl-mi1\"><span class=\"pl-mi1\">+</span> web-features:scroll-axis-lock</span>\n\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> api.Selection.collapse.offset_parameter_optional</span>\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> api.Selection.extend.offset_parameter_optional</span>\n<span class=\"pl-mi1\"><span class=\"pl-mi1\">+</span> web-features:selection-api</span>\n\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> css.properties.color-interpolation.linearRGB</span>\n<span class=\"pl-mi1\"><span class=\"pl-mi1\">+</span> web-features:svg</span>\n\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> css.types.color.system-color.accentcolor</span>\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> css.types.color.system-color.accentcolortext</span>\n<span class=\"pl-mi1\"><span class=\"pl-mi1\">+</span> web-features:system-color</span>\n\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> css.properties.text-decoration-skip-spaces</span>\n<span class=\"pl-c\"><span class=\"pl-c\">#</span> css.properties.text-decoration-skip-spaces.all</span>