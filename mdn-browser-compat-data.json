    "items": [
        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/47647?u=2fbfc431a85d357f00c0146d5e55b425b7f00a3d&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n<h4 dir=\"auto\">Summary</h4>\n<p dir=\"auto\">Chrome 136 adds support for the <a href=\"https://developer.mozilla.org/en-US/docs/Web/API/BaseAudioContext/state\" rel=\"nofollow\"><code class=\"notranslate\">BaseAudioContext.state</code></a> property's <code class=\"notranslate\">interrupted</code> value: see <a href=\"https://chromestatus.com/feature/5172068166139904\" rel=\"nofollow\">https://chromestatus.com/feature/5172068166139904</a>.</p>\n<p dir=\"auto\">See also the explainer at <a href=\"https://github.com/MicrosoftEdge/MSEdgeExplainers/blob/main/AudioContextInterruptedState/explainer.md\">https://github.com/MicrosoftEdge/MSEdgeExplainers/blob/main/AudioContextInterruptedState/explainer.md</a></p>\n<p dir=\"auto\">This PR adds a data point for the new value.</p>\n\n<h4 dir=\"auto\">Test results and supporting details</h4>\n\n\n<h4 dir=\"auto\">Related issues</h4>\n\n",
            "url": "https://github.com/mdn/browser-compat-data/pull/27304",
