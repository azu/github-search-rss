        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/1795135?u=8b4759f2d0964426ac6f2aeacf061ad1ee0e24db&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">It wasn't part of the initial beta, but it is available now.</p>\n\n<h4 dir=\"auto\">Summary</h4>\n\n<h4 dir=\"auto\">Test results and supporting details</h4>\n\n\n<h4 dir=\"auto\">Related issues</h4>\n\n",
            "url": "https://github.com/mdn/browser-compat-data/pull/29999",
            "title": "Safari 27 beta supports light-dark on image values",
