        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/12870451?u=53865490ebd18b730e5c7a1383496f38d641ab27&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n<h4 dir=\"auto\">Summary</h4>\n\n<p dir=\"auto\">Add the Firefox Bugzilla bug URL (<a href=\"https://bugzilla.mozilla.org/show_bug.cgi?id=1951795\" rel=\"nofollow\">https://bugzilla.mozilla.org/show_bug.cgi?id=1951795</a> / <a href=\"https://bugzil.la/1951795\" rel=\"nofollow\">https://bugzil.la/1951795</a>) to the css/properties/text-spacing-trim.json file.</p>\n<h4 dir=\"auto\">Test results and supporting details</h4>\n\n\n<p dir=\"auto\"><a href=\"https://github.com/mdn/browser-compat-data/blob/main/css/properties/text-spacing-trim.json\">https://github.com/mdn/browser-compat-data/blob/main/css/properties/text-spacing-trim.json</a></p>\n<h4 dir=\"auto\">Related issues</h4>\n\n",
