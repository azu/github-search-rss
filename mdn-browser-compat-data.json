        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/349114?u=1185d4fc45f5ff4c4a592b30a4dd2bb5cd1b7128&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h4 dir=\"auto\">Summary</h4>\n<p dir=\"auto\">Safari 26.2 supports position-visibility: anchors-valid</p>\n<h4 dir=\"auto\">Test results and supporting details</h4>\n<p dir=\"auto\"><a href=\"https://bugs.webkit.org/show_bug.cgi?id=297314\" rel=\"nofollow\">https://bugs.webkit.org/show_bug.cgi?id=297314</a></p>\n<h4 dir=\"auto\">Related issues</h4>\n<p dir=\"auto\">Content issue: <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3937520529\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/content/issues/43120\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/content/issues/43120/hovercard\" href=\"https://github.com/mdn/content/issues/43120\">mdn/content#43120</a></p>",
            "url": "https://github.com/mdn/browser-compat-data/pull/29046",
            "title": "Safari 26.2 supports pos-vis: anchors-valid",
            "date_modified": "2026-02-13T14:46:48.000Z",
            "date_published": "2026-02-13T14:45:52.000Z",
            "author": {
                "name": "Elchi3",
