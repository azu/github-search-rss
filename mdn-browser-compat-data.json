        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/90582190?u=42818c7d5d2ee6aa051a66f1477789350f6a5863&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h4 dir=\"auto\">Summary</h4>\n<p dir=\"auto\">Noting the Partitioned Set-Cookie attribute is enabled in the next version of Firefox.</p>\n<h4 dir=\"auto\">Test results and supporting details</h4>\n<p dir=\"auto\"><a href=\"https://bugzilla.mozilla.org/show_bug.cgi?id=1931488\" rel=\"nofollow\">https://bugzilla.mozilla.org/show_bug.cgi?id=1931488</a></p>\n<h4 dir=\"auto\">Related issues</h4>",
            "url": "https://github.com/mdn/browser-compat-data/pull/27302",
            "title": "Add support for Partitioned cookie attribute in upcoming Firefox ",
