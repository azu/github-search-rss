        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/43580235?u=cae42d5a371dd041072ce6d85a1808de05535be8&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h4 dir=\"auto\">Summary</h4>\n<blockquote>\n<p dir=\"auto\">This allows specifications to use ProgressEvents while not necessarily giving away the exact number of bytes, for example by using numbers between 0 and 1</p>\n</blockquote>\n<h4 dir=\"auto\">Test results and supporting details</h4>\n<ul dir=\"auto\">\n<li>Chromium: <a href=\"https://issues.chromium.org/issues/381969448\" rel=\"nofollow\">https://issues.chromium.org/issues/381969448</a></li>\n<li>Gecko: <a href=\"https://bugzilla.mozilla.org/show_bug.cgi?id=1943649\" rel=\"nofollow\">https://bugzilla.mozilla.org/show_bug.cgi?id=1943649</a></li>\n<li>WebKit: <a href=\"https://bugs.webkit.org/show_bug.cgi?id=288688\" rel=\"nofollow\">https://bugs.webkit.org/show_bug.cgi?id=288688</a></li>\n</ul>\n<p dir=\"auto\"><strong>WPT:</strong> <a href=\"https://wpt.fyi/results/xhr/progressevent-constructor.html?label=master&amp;label=stable&amp;product=chrome&amp;product=firefox&amp;product=safari&amp;product=edge&amp;aligned\" rel=\"nofollow\">https://wpt.fyi/results/xhr/progressevent-constructor.html?label=master&amp;label=stable&amp;product=chrome&amp;product=firefox&amp;product=safari&amp;product=edge&amp;aligned</a></p>\n<h4 dir=\"auto\">Related issues</h4>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" id=\"\" disabled=\"\" class=\"task-list-item-checkbox\"> <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3073496690\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/content/issues/39574\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/content/pull/39574/hovercard\" href=\"https://github.com/mdn/content/pull/39574\">mdn/content#39574</a></li>\n</ul>",
