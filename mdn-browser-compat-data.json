    "items": [
        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/349114?u=1185d4fc45f5ff4c4a592b30a4dd2bb5cd1b7128&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">See <a href=\"https://w3c.github.io/webappsec-credential-management/#federated\" rel=\"nofollow\">https://w3c.github.io/webappsec-credential-management/#federated</a>, the FederatedCredential interface has no members \"iconURL\" or \"name\": The constructor has these as parameters but their support seems to be identical to the constructor (and other constructor parameters also exist), so I think we should remove this here as not needed.</p>",
            "url": "https://github.com/mdn/browser-compat-data/pull/27733",
