            }
        },
        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/5179191?u=8dd92441fba3cb438759ee98862670ba56f2c67d&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">This PR updates and corrects version values for Firefox and Firefox Android for the <code class=\"notranslate\">share</code> member of the <code class=\"notranslate\">Navigator</code> API. This propogates the flag data from the parent feature.</p>",
            "url": "https://github.com/mdn/browser-compat-data/pull/27793",
            "title": "Update Firefox data for api.Navigator.share",
            "date_modified": "2025-09-09T16:45:14.000Z",
