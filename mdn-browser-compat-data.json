            }
        },
        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/5179191?u=8dd92441fba3cb438759ee98862670ba56f2c67d&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">This PR removes the <code class=\"notranslate\">SnapEvent</code> member of the <code class=\"notranslate\">SnapEvent</code> API from BCD. The collector reports that the constructor is an illegal constructor in Chromium.</p>\n<p dir=\"auto\">Tests Used: <a href=\"https://mdn-bcd-collector.gooborg.com/tests/api/SnapEvent/SnapEvent\" rel=\"nofollow\">https://mdn-bcd-collector.gooborg.com/tests/api/SnapEvent/SnapEvent</a></p>",
