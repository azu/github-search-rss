        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/466239?u=9162d8004dbd57231db58847c194e026ada8a4c7&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><h4 dir=\"auto\">Summary</h4>\n<p dir=\"auto\">This PR updates the Firefox support for <code class=\"notranslate\">console.timeStamp</code>. It was partially supported until v149, and we added the full support back in 149.</p>\n<h4 dir=\"auto\">Test results and supporting details</h4>\n<p dir=\"auto\">Bugzilla bug that adds support back: <a href=\"https://bugzil.la/1387528\" rel=\"nofollow\">https://bugzil.la/1387528</a></p>",
