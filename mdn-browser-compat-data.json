        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/108879845?u=eeb9306682180ab80521c80fd8f46609fe3c6770&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">The output of the <code class=\"notranslate\">tag-web-features</code> script is:</p>\n<blockquote>\n<p dir=\"auto\">@mdn/browser-compat-data@7.1.2 tag-web-features<br>\ntsx scripts/tag-web-features.ts ..</p>\n</blockquote>\n<div class=\"highlight highlight-source-diff notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"# api.CustomElementRegistry.define.connectedMoveCallback_lifecycle_callback\n+ web-features:move-before\"><pre class=\"notranslate\"><span class=\"pl-c\"><span class=\"pl-c\">#</span> api.CustomElementRegistry.define.connectedMoveCallback_lifecycle_callback</span>\n<span class=\"pl-mi1\"><span class=\"pl-mi1\">+</span> web-features:move-before</span></pre></div>",
