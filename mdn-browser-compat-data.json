        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/495429?u=2f3b9dd03c6c4a961d44a632fe1976c73fa19e1f&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n<h4 dir=\"auto\">Summary</h4>\n<p dir=\"auto\">Fixes a typo in the description of a WebTransportBidirectionalStream subfeature.</p>\n<h4 dir=\"auto\">Test results and supporting details</h4>\n\n\n<h4 dir=\"auto\">Related issues</h4>\n<p dir=\"auto\"><span class=\"issue-keyword tooltipped tooltipped-se\" aria-label=\"This pull request closes issue #28231.\">Fixes</span> <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3528243847\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/browser-compat-data/issues/28231\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/browser-compat-data/issues/28231/hovercard\" href=\"https://github.com/mdn/browser-compat-data/issues/28231\">#28231</a>.</p>",
