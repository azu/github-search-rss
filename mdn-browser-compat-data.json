        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/143106292?u=b3c5814362982b570863d2bb4e99cc0cc32ec862&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/>\n<h4 dir=\"auto\">Summary</h4>\n\n<p dir=\"auto\">Adds <code class=\"notranslate\">execute</code>, <code class=\"notranslate\">InjectionUserScript</code>, <code class=\"notranslate\">InjectionResult</code>, and <code class=\"notranslate\">InjectionTarget</code> BCD.</p>\n<h4 dir=\"auto\">Test results and supporting details</h4>\n\n\n<p dir=\"auto\"><a href=\"https://developer.chrome.com/docs/extensions/reference/api/userScripts#method-execute\" rel=\"nofollow\">https://developer.chrome.com/docs/extensions/reference/api/userScripts#method-execute</a><br>\n<a href=\"https://bugzilla.mozilla.org/show_bug.cgi?id=1930776\" rel=\"nofollow\">https://bugzilla.mozilla.org/show_bug.cgi?id=1930776</a></p>\n<h4 dir=\"auto\">Related issues</h4>\n\n<p dir=\"auto\"><span class=\"issue-keyword tooltipped tooltipped-se\" aria-label=\"This pull request closes issue #26938.\">Fixes</span> <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3100921633\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/browser-compat-data/issues/26938\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/browser-compat-data/issues/26938/hovercard\" href=\"https://github.com/mdn/browser-compat-data/issues/26938\">#26938</a></p>\n<h4 dir=\"auto\">Note</h4>\n<p dir=\"auto\">This pr is related with <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3115794378\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/content/issues/39781\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mdn/content/pull/39781/hovercard\" href=\"https://github.com/mdn/content/pull/39781\">mdn/content#39781</a></p>\n",
