                "name": "hamishwillee",
                "url": "https://github.com/hamishwillee"
            }
        },
        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/5368500?v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">FF146 supports WebCrypto import of EC keys in compressed format in <a href=\"https://bugzilla.mozilla.org/show_bug.cgi?id=1971499\" rel=\"nofollow\">https://bugzilla.mozilla.org/show_bug.cgi?id=1971499</a></p>\n<p dir=\"auto\">I've added as a subfeature of importKey</p>\n<p dir=\"auto\">Related docs work can be tracked in <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"3607703023\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mdn/content/issues/41870\" data-hovercard-type=\"issue\" data-hovercard-url=\"/mdn/content/issues/41870/hovercard\" href=\"https://github.com/mdn/content/issues/41870\">mdn/content#41870</a></p>",
            "url": "https://github.com/mdn/browser-compat-data/pull/28497",
