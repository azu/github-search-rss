            <name>ahmedmoussa10</name>
            <email>ahmedmoussa10@noreply.github.com</email>
            <uri>https://github.com/ahmedmoussa10</uri>
        </author>
        <published>2025-10-14T00:00:58.000Z</published>
    </entry>
