        <title type="html"><![CDATA[Remove old code editor and active learning from Creating links]]></title>
        <id>https://github.com/mdn/content/pull/39867</id>
        <link href="https://github.com/mdn/content/pull/39867"/>
        <updated>2025-06-09T09:12:49.000Z</updated>
