        <title type="html"><![CDATA[FF157 Relnote: Export * from module proposal]]></title>
        <id>https://github.com/mdn/content/pull/45843</id>
        <link href="https://github.com/mdn/content/pull/45843"/>
        <updated>2026-09-25T14:50:28.000Z</updated>
