[link](https://github.com/prettier/prettier/blob/main/ &quot;title&quot;)
&lt;!-- Prettier 3.9.5 --&gt;
&lt;/tr&gt;&lt;/table&gt;"><pre class="notranslate"><span class="pl-c"><span class="pl-c">&lt;!--</span> Input <span class="pl-c">--&gt;</span></span>
<span class="pl-s">[</span>link<span class="pl-s">]</span><span class="pl-s">(</span><span class="pl-corl">https://github.com/prettier/prettier/blob/main/&lt;&gt;</span> <span class="pl-s">"</span><span class="pl-s">title</span><span class="pl-s">")</span>
<span class="pl-c"><span class="pl-c">&lt;!--</span> Prettier 3.9.4 <span class="pl-c">--&gt;</span></span>
<span class="pl-s">[</span>link<span class="pl-s">]</span><span class="pl-s">(</span><span class="pl-corl">https://github.com/prettier/prettier/blob/main/</span> <span class="pl-s">"</span><span class="pl-s">title</span><span class="pl-s">")</span>
<span class="pl-c"><span class="pl-c">&lt;!--</span> Prettier 3.9.5 <span class="pl-c">--&gt;</span></span>
&lt;/<span class="pl-ent">tr</span>&gt;&lt;/<span class="pl-ent">table</span>&gt;</pre></div><p dir="auto"></p>
