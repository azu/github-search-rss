        <title type="html"><![CDATA[More explicitly recommend iframe for PDFs]]></title>
        <id>https://github.com/mdn/content/pull/45614</id>
        <link href="https://github.com/mdn/content/pull/45614"/>
        <updated>2026-09-12T03:57:41.000Z</updated>
