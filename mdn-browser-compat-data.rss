        <title type="html"><![CDATA[Fx 158 supports WebGPU float32-blendable feature]]></title>
        <id>https://github.com/mdn/browser-compat-data/pull/30783</id>
        <link href="https://github.com/mdn/browser-compat-data/pull/30783"/>
        <updated>2026-10-07T16:34:18.000Z</updated>
        <content type="html"><![CDATA[<img src="https://avatars.githubusercontent.com/u/47647?u=2fbfc431a85d357f00c0146d5e55b425b7f00a3d&v=4" width="64" height="64" alt=""/><br/>
<h4 dir="auto">Summary</h4>
<p dir="auto">Firefox 158 adds support for the WebGPU <code class="notranslate">float32-blendable</code> feature. See <a href="https://bugzilla.mozilla.org/show_bug.cgi?id=1931630" rel="nofollow">https://bugzilla.mozilla.org/show_bug.cgi?id=1931630</a>.</p>
<p dir="auto">This PR adds Firefox 158 support to the relevant data point.</p>
<p dir="auto">The wording of the bug is a bit confusing, but I'm assuming it is supported because the following code lists it as an available feature in both the adapter and the resulting device:</p>
<div class="highlight highlight-source-js notranslate position-relative overflow-auto" dir="auto" data-snippet-clipboard-copy-content="async function init() {
  if (!navigator.gpu) {
    throw Error(&quot;WebGPU not supported.&quot;);
  }

  const adapter = await navigator.gpu.requestAdapter();
  if (!adapter) {
    throw Error(&quot;Couldn't request WebGPU adapter.&quot;);
  }

  for (feature of adapter.features) {
    console.log(feature);
  }

  const device = await adapter.requestDevice({
    requiredFeatures: [&quot;float32-blendable&quot;],
  });

  console.log(device);

  for (feature of device.features) {
    console.log(feature);
  }
}

init();"><pre class="notranslate"><span class="pl-k">async</span> <span class="pl-k">function</span> <span class="pl-en">init</span><span class="pl-kos">(</span><span class="pl-kos">)</span> <span class="pl-kos">{</span>
  <span class="pl-k">if</span> <span class="pl-kos">(</span><span class="pl-c1">!</span><span class="pl-s1">navigator</span><span class="pl-kos">.</span><span class="pl-c1">gpu</span><span class="pl-kos">)</span> <span class="pl-kos">{</span>
    <span class="pl-k">throw</span> <span class="pl-v">Error</span><span class="pl-kos">(</span><span class="pl-s">"WebGPU not supported."</span><span class="pl-kos">)</span><span class="pl-kos">;</span>
  <span class="pl-kos">}</span>

  <span class="pl-k">const</span> <span class="pl-s1">adapter</span> <span class="pl-c1">=</span> <span class="pl-k">await</span> <span class="pl-s1">navigator</span><span class="pl-kos">.</span><span class="pl-c1">gpu</span><span class="pl-kos">.</span><span class="pl-en">requestAdapter</span><span class="pl-kos">(</span><span class="pl-kos">)</span><span class="pl-kos">;</span>
  <span class="pl-k">if</span> <span class="pl-kos">(</span><span class="pl-c1">!</span><span class="pl-s1">adapter</span><span class="pl-kos">)</span> <span class="pl-kos">{</span>
    <span class="pl-k">throw</span> <span class="pl-v">Error</span><span class="pl-kos">(</span><span class="pl-s">"Couldn't request WebGPU adapter."</span><span class="pl-kos">)</span><span class="pl-kos">;</span>
  <span class="pl-kos">}</span>

  <span class="pl-k">for</span> <span class="pl-kos">(</span><span class="pl-s1">feature</span> <span class="pl-k">of</span> <span class="pl-s1">adapter</span><span class="pl-kos">.</span><span class="pl-c1">features</span><span class="pl-kos">)</span> <span class="pl-kos">{</span>
    <span class="pl-smi">console</span><span class="pl-kos">.</span><span class="pl-en">log</span><span class="pl-kos">(</span><span class="pl-s1">feature</span><span class="pl-kos">)</span><span class="pl-kos">;</span>
  <span class="pl-kos">}</span>

  <span class="pl-k">const</span> <span class="pl-s1">device</span> <span class="pl-c1">=</span> <span class="pl-k">await</span> <span class="pl-s1">adapter</span><span class="pl-kos">.</span><span class="pl-en">requestDevice</span><span class="pl-kos">(</span><span class="pl-kos">{</span>
    <span class="pl-c1">requiredFeatures</span>: <span class="pl-kos">[</span><span class="pl-s">"float32-blendable"</span><span class="pl-kos">]</span><span class="pl-kos">,</span>
  <span class="pl-kos">}</span><span class="pl-kos">)</span><span class="pl-kos">;</span>

  <span class="pl-smi">console</span><span class="pl-kos">.</span><span class="pl-en">log</span><span class="pl-kos">(</span><span class="pl-s1">device</span><span class="pl-kos">)</span><span class="pl-kos">;</span>

  <span class="pl-k">for</span> <span class="pl-kos">(</span><span class="pl-s1">feature</span> <span class="pl-k">of</span> <span class="pl-s1">device</span><span class="pl-kos">.</span><span class="pl-c1">features</span><span class="pl-kos">)</span> <span class="pl-kos">{</span>
    <span class="pl-smi">console</span><span class="pl-kos">.</span><span class="pl-en">log</span><span class="pl-kos">(</span><span class="pl-s1">feature</span><span class="pl-kos">)</span><span class="pl-kos">;</span>
  <span class="pl-kos">}</span>
<span class="pl-kos">}</span>

<span class="pl-en">init</span><span class="pl-kos">(</span><span class="pl-kos">)</span><span class="pl-kos">;</span></pre></div>

