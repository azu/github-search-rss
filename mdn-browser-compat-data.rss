<a target="_blank" rel="noopener noreferrer" href="https://private-user-images.githubusercontent.com/9437625/579393739-bcbaf202-9557-498a-961d-2ac48825f2a1.png?jwt=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..TipnCOGUealxMr6eZ_O0jPDxDdWgpBflXHaC3kCAgnM"><img width="550" height="145" alt="image" src="https://private-user-images.githubusercontent.com/9437625/579393739-bcbaf202-9557-498a-961d-2ac48825f2a1.png?jwt=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..TipnCOGUealxMr6eZ_O0jPDxDdWgpBflXHaC3kCAgnM" style="max-width: 100%; height: auto; max-height: 145px;; aspect-ratio: 550 / 145; background-color: var(--bgColor-muted); border-radius: 6px; display: block" class="js-gh-image-fallback"></a>
