    <entry>
        <title type="html"><![CDATA[Chrome 133 already added `::checkmark` CSS pseudo-element]]></title>
        <id>https://github.com/mdn/browser-compat-data/pull/27545</id>
        <link href="https://github.com/mdn/browser-compat-data/pull/27545"/>
